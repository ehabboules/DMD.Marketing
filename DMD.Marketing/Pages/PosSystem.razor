@page "/pos-system"

<PageTitle>Point of Sale System — DMD Inventory</PageTitle>

<!-- Hero -->
<div class="pg-hero">
    <div class="pg-hero-inner">
        <div class="pg-hero-copy">
            <div class="pg-eyebrow">Point of Sale</div>
            <h1 class="pg-title">A POS terminal built<br />for speed and simplicity.</h1>
            <p class="pg-sub">Touch-friendly, fast, and connected to your inventory in real time. DMD's POS handles checkout, returns, cash sessions, and Canadian taxes — all in one screen.</p>
            <div class="pg-hero-actions">
                <a href="/register" class="btn-primary">Try free for 14 days</a>
                <a href="/features" class="btn-secondary">See all features</a>
            </div>
        </div>
        <div class="pg-hero-art">
            <svg viewBox="0 0 400 320" width="400" height="320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- Tablet frame -->
                <rect x="90" y="30" width="220" height="260" rx="16" fill="#1A237E"/>
                <rect x="96" y="36" width="208" height="248" rx="12" fill="#0D1B6B"/>
                <!-- Home bar -->
                <rect x="178" y="270" width="44" height="6" rx="3" fill="white" opacity="0.3"/>
                <!-- Screen content -->
                <rect x="100" y="40" width="200" height="226" rx="10" fill="#F0F4FF"/>
                <!-- App header bar -->
                <rect x="100" y="40" width="200" height="36" rx="10" fill="#1A237E"/>
                <rect x="100" y="58" width="200" height="18" rx="0" fill="#1A237E"/>
                <text x="130" y="62" font-family="Poppins, sans-serif" font-size="10" fill="white" font-weight="600">POS Terminal</text>
                <!-- Cart icon in header -->
                <circle cx="285" cy="58" r="12" fill="#00BFA5" opacity="0.3"/>
                <path d="M279 55h2l3 7h8l1-4h-10" stroke="white" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                <!-- Search bar -->
                <rect x="108" y="82" width="184" height="22" rx="6" fill="white"/>
                <circle cx="122" cy="93" r="5" fill="none" stroke="#9CA3AF" stroke-width="1.5"/>
                <line x1="126" y1="97" x2="129" y2="100" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round"/>
                <rect x="132" y="89" width="80" height="8" rx="2" fill="#E5E7EB"/>
                <!-- Product grid -->
                <rect x="108" y="110" width="56" height="50" rx="6" fill="white"/>
                <rect x="108" y="110" width="56" height="28" rx="6" fill="#E0F7F4"/>
                <rect x="108" y="124" width="56" height="14" rx="0" fill="#E0F7F4"/>
                <text x="136" y="121" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="8" fill="#00897B" font-weight="600">Almonds</text>
                <text x="136" y="152" text-anchor="middle" font-family="Poppins, sans-serif" font-size="9" fill="#1C1C1E" font-weight="700">$14.99</text>

                <rect x="172" y="110" width="56" height="50" rx="6" fill="white"/>
                <rect x="172" y="110" width="56" height="28" rx="6" fill="#E8EAF6"/>
                <rect x="172" y="124" width="56" height="14" rx="0" fill="#E8EAF6"/>
                <text x="200" y="121" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="8" fill="#1A237E" font-weight="600">Cashews</text>
                <text x="200" y="152" text-anchor="middle" font-family="Poppins, sans-serif" font-size="9" fill="#1C1C1E" font-weight="700">$19.99</text>

                <rect x="236" y="110" width="56" height="50" rx="6" fill="white"/>
                <rect x="236" y="110" width="56" height="28" rx="6" fill="#E0F7F4"/>
                <rect x="236" y="124" width="56" height="14" rx="0" fill="#E0F7F4"/>
                <text x="264" y="121" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="8" fill="#00897B" font-weight="600">Pistachios</text>
                <text x="264" y="152" text-anchor="middle" font-family="Poppins, sans-serif" font-size="9" fill="#1C1C1E" font-weight="700">$22.99</text>

                <!-- Cart section -->
                <rect x="108" y="168" width="184" height="56" rx="6" fill="white"/>
                <text x="116" y="181" font-family="DM Sans, sans-serif" font-size="8" fill="#6B7280" font-weight="600">ORDER</text>
                <rect x="108" y="183" width="184" height="1" fill="#E5E7EB"/>
                <!-- Cart row -->
                <text x="116" y="196" font-family="DM Sans, sans-serif" font-size="8" fill="#1C1C1E">Almonds 500g × 2</text>
                <text x="276" y="196" font-family="Poppins, sans-serif" font-size="8" fill="#1C1C1E" font-weight="600">$29.98</text>
                <text x="116" y="208" font-family="DM Sans, sans-serif" font-size="8" fill="#1C1C1E">Pistachios 250g × 1</text>
                <text x="276" y="208" font-family="Poppins, sans-serif" font-size="8" fill="#1C1C1E" font-weight="600">$11.50</text>
                <!-- Total / Pay button -->
                <rect x="108" y="230" width="184" height="30" rx="6" fill="#00BFA5"/>
                <text x="200" y="249" text-anchor="middle" font-family="Poppins, sans-serif" font-size="11" fill="white" font-weight="700">Pay  $41.48</text>
                <!-- Floating card symbol -->
                <rect x="310" y="80" width="60" height="42" rx="6" fill="#1A237E"/>
                <rect x="310" y="92" width="60" height="10" fill="#00BFA5" opacity="0.8"/>
                <rect x="318" y="108" width="16" height="8" rx="2" fill="white" opacity="0.5"/>
                <rect x="340" y="108" width="22" height="8" rx="2" fill="white" opacity="0.3"/>
                <!-- Tap rings -->
                <circle cx="344" cy="60" r="8" fill="none" stroke="#00BFA5" stroke-width="1.5" opacity="0.7"/>
                <circle cx="344" cy="60" r="14" fill="none" stroke="#00BFA5" stroke-width="1" opacity="0.4"/>
                <circle cx="344" cy="60" r="20" fill="none" stroke="#00BFA5" stroke-width="0.8" opacity="0.2"/>
                <!-- Decorative circles -->
                <circle cx="40" cy="160" r="22" fill="#E0F7F4"/>
                <circle cx="40" cy="160" r="12" fill="#00BFA5" opacity="0.2"/>
                <circle cx="360" cy="260" r="16" fill="#E8EAF6"/>
                <circle cx="360" cy="260" r="9" fill="#1A237E" opacity="0.2"/>
            </svg>
        </div>
    </div>
</div>

<!-- Main features grid -->
<section class="pg-section">
    <div class="pg-container">
        <div class="pg-section-header">
            <h2 class="pg-heading">Everything at the checkout counter</h2>
            <p class="pg-heading-sub">Six core capabilities, built to work together without switching screens.</p>
        </div>
        <div class="pg-feat-grid">

            <div class="pg-feat-card pg-feat-card--wide">
                <div class="pg-feat-icon pg-feat-icon--teal">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                </div>
                <h3>POS Terminal</h3>
                <p>Search products by name or barcode, manage the cart with quantity controls, apply order-level and item-level discounts, add order notes, and select a payment method. Supports Cash, Card, and Stripe Terminal.</p>
                <ul class="feat-list">
                    <li>Lightning-fast product search</li>
                    <li>Order + item-level discounts</li>
                    <li>Age restriction warnings</li>
                    <li>Order notes and references</li>
                    <li>Receipt printing</li>
                </ul>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--teal">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3z"/></svg>
                </div>
                <h3>Stripe Terminal</h3>
                <p>Card-present payments via Stripe Reader. Semi-integrated setup keeps your workflow fast. No separate payment terminal software required.</p>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--teal">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </div>
                <h3>Returns & Refunds</h3>
                <p>Select any past order, choose items to return, and inventory is automatically restored. Orders are marked Refunded or Partial — no manual stock adjustments needed.</p>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--teal">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <h3>Cash Session Management</h3>
                <p>Open sessions with an opening float and close with a counted total. View discrepancies, see active sessions across registers, and access full session history.</p>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--teal">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                </div>
                <h3>Multiple Registers</h3>
                <p>Add and assign as many cash registers as your locations need. Each register tracks its own sessions independently. Perfect for multi-lane or multi-location setups.</p>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--teal">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <h3>Canadian Tax Engine</h3>
                <p>Federal GST and provincial PST applied per product, per province — automatically. Tax compliance is built in, not configured after the fact. Receipts are always correct.</p>
            </div>

        </div>
    </div>
</section>

<!-- How it connects -->
<section class="pg-section pg-section--alt">
    <div class="pg-container">
        <div class="pg-section-header">
            <h2 class="pg-heading">Your POS doesn't exist in isolation</h2>
            <p class="pg-heading-sub">Every POS transaction updates inventory, logs movement history, and feeds your financial dashboard automatically.</p>
        </div>
        <div class="connect-grid">
            <div class="connect-card">
                <div class="connect-num">01</div>
                <h3>Inventory syncs on every sale</h3>
                <p>When a product is sold, stock is decremented across the right warehouse instantly. No separate inventory step required.</p>
            </div>
            <div class="connect-card">
                <div class="connect-num">02</div>
                <h3>Returns restore stock automatically</h3>
                <p>Process a return and stock is added back without touching the inventory screen. The movement log records every transaction.</p>
            </div>
            <div class="connect-card">
                <div class="connect-num">03</div>
                <h3>Revenue flows to reports</h3>
                <p>Every transaction feeds your financial dashboard, sales summary, and tax report in real time. End-of-day is already done when you close your session.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="pg-cta">
    <div class="pg-container pg-cta-inner">
        <h2>Ready to run a faster checkout?</h2>
        <p>14-day free trial. No credit card required.</p>
        <div class="pg-cta-buttons">
            <a href="/register" class="btn-primary">Start free trial</a>
            <a href="/pricing" class="btn-secondary">View pricing</a>
        </div>
    </div>
</section>

<style>
    :root {
        --teal: #00BFA5; --teal-dark: #00897B; --teal-light: #E0F7F4;
        --navy: #1A237E; --text: #1C1C1E; --text-muted: #6B7280;
        --border: #E5E7EB; --surface: #F9FAFB; --white: #FFFFFF;
    }

    .pg-hero {
        background: #FFFFFF; border-bottom: 1px solid var(--border);
        padding: 5rem 2rem 4rem;
        position: relative; overflow: hidden;
    }
    .pg-hero::after {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse 70% 55% at 50% 100%, rgba(0,191,165,0.07) 0%, transparent 65%);
        pointer-events: none;
    }
    .pg-hero-inner { position: relative; max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
    .pg-hero-copy { text-align: left; }
    .pg-hero-art { display: flex; justify-content: center; align-items: center; }
    @@media (max-width: 768px) { .pg-hero-inner { grid-template-columns: 1fr; } .pg-hero-art { display: none; } }
    .pg-eyebrow {
        display: inline-block; background: var(--teal-light); color: var(--teal-dark);
        font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 600;
        letter-spacing: 0.1em; text-transform: uppercase;
        padding: 0.35rem 1rem; border-radius: 20px;
        border: 1px solid rgba(0,191,165,0.25); margin-bottom: 1.5rem;
    }
    .pg-title {
        font-family: 'Poppins', sans-serif;
        font-size: 2.75rem;
        font-weight: 700; color: var(--text); line-height: 1.2; margin: 0 0 1.25rem;
    }
    .pg-sub {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.1rem; color: var(--text-muted); line-height: 1.7; margin: 0 0 2rem;
    }
    .pg-hero-actions { display: flex; gap: 1rem; justify-content: flex-start; flex-wrap: wrap; }

    .pg-section { padding: 4rem 2rem; }
    .pg-section--alt { background: var(--surface); }
    .pg-container { max-width: 1100px; margin: 0 auto; }

    .pg-section-header { text-align: center; margin-bottom: 3rem; }
    .pg-heading {
        font-family: 'Poppins', sans-serif; font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700; color: var(--text); margin: 0 0 0.75rem;
    }
    .pg-heading-sub {
        font-family: 'DM Sans', sans-serif; font-size: 1rem;
        color: var(--text-muted); margin: 0; max-width: 560px; margin: 0 auto;
    }

    .pg-feat-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
    .pg-feat-card--wide { grid-column: span 2; }
    .pg-feat-card {
        background: var(--white); border: 1px solid var(--border); border-radius: 14px;
        padding: 1.5rem; transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
    }
    .pg-feat-card:hover { border-color: var(--teal); box-shadow: 0 4px 20px rgba(0,191,165,0.1); transform: translateY(-2px); }
    .pg-feat-icon {
        width: 42px; height: 42px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;
    }
    .pg-feat-icon--teal { background: var(--teal-light); color: var(--teal-dark); }
    .pg-feat-card h3 { font-family: 'Poppins', sans-serif; font-size: 1rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem; }
    .pg-feat-card p { font-family: 'DM Sans', sans-serif; font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; margin: 0 0 0.75rem; }

    .feat-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
    .feat-list li {
        font-family: 'DM Sans', sans-serif; font-size: 0.84rem; color: var(--text-muted);
        padding-left: 1.25rem; position: relative;
    }
    .feat-list li::before { content: '✓'; position: absolute; left: 0; color: var(--teal); font-weight: 700; }

    .connect-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
    .connect-card {
        background: var(--white); border: 1px solid var(--border); border-radius: 14px;
        padding: 1.75rem;
    }
    .connect-num {
        font-family: 'Poppins', sans-serif; font-size: 2rem; font-weight: 800;
        color: var(--teal-light); margin-bottom: 0.75rem; line-height: 1;
    }
    .connect-card h3 { font-family: 'Poppins', sans-serif; font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem; }
    .connect-card p { font-family: 'DM Sans', sans-serif; font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; margin: 0; }

    .pg-cta { padding: 5rem 2rem; background: var(--surface); border-top: 1px solid var(--border); text-align: center; }
    .pg-cta-inner { max-width: 560px; margin: 0 auto; }
    .pg-cta h2 { font-family: 'Poppins', sans-serif; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--text); margin: 0 0 0.75rem; }
    .pg-cta p { font-family: 'DM Sans', sans-serif; font-size: 1rem; color: var(--text-muted); margin: 0 0 2rem; }
    .pg-cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    .btn-primary {
        background: var(--teal); color: #FFFFFF; font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; font-weight: 700; padding: 0.8rem 1.75rem;
        border-radius: 8px; text-decoration: none; transition: background 0.2s;
    }
    .btn-primary:hover { background: var(--teal-dark); }
    .btn-secondary {
        background: var(--white); color: var(--text); font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; font-weight: 600; padding: 0.8rem 1.75rem;
        border-radius: 8px; text-decoration: none;
        border: 1px solid var(--border); transition: border-color 0.2s, background 0.2s;
    }
    .btn-secondary:hover { border-color: var(--teal); background: var(--teal-light); }

    @@media (max-width: 768px) {
        .pg-feat-grid { grid-template-columns: 1fr; }
        .pg-feat-card--wide { grid-column: span 1; }
    }
</style>
