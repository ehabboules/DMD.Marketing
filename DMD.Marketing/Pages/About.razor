                <circle cx="368" cy="242" r="7" fill="#1A237E" opacity="0.4"/>
                <rect x="359" y="250" width="18" height="14" rx="6" fill="#1A237E" opacity="0.2"/>

                <!-- Ground line -->
                <rect x="30" y="278" width="340" height="4" rx="2" fill="#E5E7EB"/>

                <!-- Floating badge -->
                <rect x="28" y="60" width="100" height="44" rx="8" fill="#1A237E"/>
                <text x="78" y="79" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="8" fill="white" opacity="0.7">Founded</text>
                <text x="78" y="95" text-anchor="middle" font-family="Poppins, sans-serif" font-size="14" fill="#00BFA5" font-weight="700">2022</text>

                <!-- Decorative circles -->
                <circle cx="380" cy="110" r="16" fill="#E0F7F4"/>
                <circle cx="380" cy="110" r="9" fill="#00BFA5" opacity="0.25"/>
