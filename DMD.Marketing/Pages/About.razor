                <rect x="120" y="178" width="34" height="28" rx="3" fill="#00BFA5" opacity="0.3"/>
                <rect x="164" y="178" width="34" height="28" rx="3" fill="#1A237E" opacity="0.2"/>
                <rect x="208" y="178" width="34" height="28" rx="3" fill="#1A237E" opacity="0.4"/>
                <rect x="248" y="178" width="34" height="28" rx="3" fill="#00BFA5" opacity="0.4"/>

                <!-- Building roof / header -->
                <rect x="90" y="108" width="220" height="24" rx="4" fill="#1A237E"/>
                <!-- Rooftop accent -->
                <rect x="140" y="96" width="120" height="14" rx="3" fill="#1A237E" opacity="0.6"/>
