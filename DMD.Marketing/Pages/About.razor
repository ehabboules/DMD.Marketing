                <!-- Team people dots -->
                <circle cx="50" cy="240" r="18" fill="#E0F7F4"/>
                <circle cx="50" cy="230" r="9" fill="#00BFA5" opacity="0.5"/>
                <rect x="38" y="240" width="24" height="18" rx="8" fill="#00BFA5" opacity="0.3"/>

                <circle cx="90" cy="250" r="16" fill="#E8EAF6"/>
                <circle cx="90" cy="241" r="8" fill="#1A237E" opacity="0.4"/>
                <rect x="79" y="250" width="22" height="16" rx="7" fill="#1A237E" opacity="0.2"/>

                <circle cx="330" cy="240" r="18" fill="#E0F7F4"/>
                <circle cx="330" cy="230" r="9" fill="#00BFA5" opacity="0.5"/>
                <rect x="318" y="240" width="24" height="18" rx="8" fill="#00BFA5" opacity="0.3"/>

