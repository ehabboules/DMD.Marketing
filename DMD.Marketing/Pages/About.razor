                <rect x="140" y="112" width="120" height="12" rx="2" fill="white" opacity="0.9"/>
                <text x="200" y="121" text-anchor="middle" font-family="Poppins, sans-serif" font-size="8" fill="#1A237E" font-weight="700">DMD TECH</text>

                <!-- Door -->
