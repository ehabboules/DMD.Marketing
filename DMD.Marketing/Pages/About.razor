                <circle cx="20" cy="140" r="8" fill="#1A237E" opacity="0.2"/>
            </svg>
        </div>
    </div>
</div>

<!-- Mission -->
<section class="about-section">
    <div class="about-container about-mission">
        <div class="about-mission-text">
            <div class="about-label">Our mission</div>
            <h2 class="about-heading">Make modern retail software accessible to every Canadian retailer.</h2>
            <p>Enterprise-grade POS and inventory systems have historically been too expensive, too complicated, or designed for international markets with no real understanding of Canadian tax law or retail realities.</p>
            <p>DMD Inventory is our answer: a modern, affordable, Canadian-built platform that covers the full retail workflow — from checkout to purchasing to financial reporting — without the complexity or cost of legacy systems.</p>
        </div>
        <div class="about-mission-values">
            <div class="value-card">
                <div class="value-icon">🎯</div>
                <strong>Focused</strong>
                <p>We build what Canadian retailers actually need, not every feature imaginable.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">🇨🇦</div>
                <strong>Canadian-first</strong>
                <p>GST, PST, provincial rules, and bilingual support are built-in defaults — not add-ons.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">🔒</div>
                <strong>Multi-tenant secure</strong>
                <p>Every business runs in its own isolated environment. Your data stays yours.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">⚡</div>
                <strong>Fast to deploy</strong>
                <p>Most retailers are fully live within a day — not a month-long implementation project.</p>
            </div>
        </div>
    </div>
</section>

<!-- Product overview -->
<section class="about-section about-section--alt">
    <div class="about-container">
        <div class="about-label">What we've built</div>
        <h2 class="about-heading">One platform for the full retail workflow.</h2>
        <div class="product-grid">
            <div class="product-card">
                <div class="product-icon product-icon--teal">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                </div>
                <h3>Point of Sale</h3>
                <p>Touch-friendly terminal with product search, discounts, Stripe Terminal, returns, and cash session management.</p>
                <a href="/pos-system" class="product-link">Learn more →</a>
            </div>
            <div class="product-card">
                <div class="product-icon product-icon--navy">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <h3>Inventory Management</h3>
                <p>Multi-warehouse stock tracking, movement logs, low stock alerts, and Excel exports.</p>
                <a href="/inventory-management" class="product-link">Learn more →</a>
            </div>
            <div class="product-card">
                <div class="product-icon product-icon--orange">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </div>
                <h3>Purchasing</h3>
                <p>Full PO lifecycle from creation to receiving, with supplier management and cost tracking.</p>
                <a href="/features#purchases" class="product-link">Learn more →</a>
            </div>
            <div class="product-card">
                <div class="product-icon product-icon--green">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                </div>
                <h3>Reports & Analytics</h3>
                <p>Sales, financial, inventory, and tax reports — all built in, no spreadsheet required.</p>
                <a href="/reports-analytics" class="product-link">Learn more →</a>
            </div>
        </div>
    </div>
</section>

<!-- Who we serve -->
<section class="about-section">
    <div class="about-container">
        <div class="about-label">Who we build for</div>
        <h2 class="about-heading">Any Canadian retailer who needs a serious system without enterprise complexity.</h2>
        <div class="industry-list">
            <div class="industry-item">
                <span class="industry-icon">🏪</span>
                <div>
                    <strong>General retail stores</strong>
                    <span>Clothing, electronics, gifts, specialty goods</span>
                </div>
            </div>
            <div class="industry-item">
                <span class="industry-icon">🌾</span>
                <div>
                    <strong>Nuts & dry goods</strong>
                    <span>Bulk and weight-based retail</span>
                </div>
            </div>
            <div class="industry-item">
                <span class="industry-icon">🛒</span>
                <div>
                    <strong>Grocery & supermarkets</strong>
                    <span>High-volume, multi-category stores</span>
                </div>
            </div>
            <div class="industry-item">
                <span class="industry-icon">🍽️</span>
                <div>
                    <strong>Quick-service restaurants</strong>
                    <span>Counter-service and takeout operations</span>
                </div>
            </div>
            <div class="industry-item">
                <span class="industry-icon">🏢</span>
                <div>
                    <strong>Multi-location retailers</strong>
                    <span>Franchises and chains needing per-tenant isolation</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact CTA -->
<section class="about-cta">
    <div class="about-container about-cta-inner">
        <h2>Have a question or want to learn more?</h2>
        <p>Our team is happy to answer questions, provide a walkthrough, or help you decide if DMD is the right fit for your business.</p>
        <div class="about-cta-buttons">
            <a href="/contact" class="btn-primary">Get in touch</a>
            <a href="/pricing" class="btn-secondary">View pricing</a>
        </div>
    </div>
</section>

<style>
    :root {
        --teal: #00BFA5; --teal-dark: #00897B; --teal-light: #E0F7F4;
        --navy: #1A237E; --navy-light: #E8EAF6;
        --text: #1C1C1E; --text-muted: #6B7280;
        --border: #E5E7EB; --surface: #F9FAFB; --white: #FFFFFF;
    }

    .about-hero {
        background: #FFFFFF; border-bottom: 1px solid var(--border);
        padding: 5rem 2rem 4rem;
        position: relative; overflow: hidden;
    }
    .about-hero::after {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse 70% 55% at 50% 100%, rgba(0,191,165,0.07) 0%, transparent 65%);
        pointer-events: none;
    }
    .about-hero-inner { position: relative; max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
    .about-hero-copy { text-align: left; }
    .about-hero-art { display: flex; justify-content: center; align-items: center; }
    @@media (max-width: 768px) { .about-hero-inner { grid-template-columns: 1fr; } .about-hero-art { display: none; } }
    .about-eyebrow {
        display: inline-block; background: var(--teal-light); color: var(--teal-dark);
        font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 600;
        letter-spacing: 0.1em; text-transform: uppercase;
        padding: 0.35rem 1rem; border-radius: 20px;
        border: 1px solid rgba(0,191,165,0.25); margin-bottom: 1.5rem;
    }
    .about-title {
        font-family: 'Poppins', sans-serif; font-size: 2.75rem;
        font-weight: 700; color: var(--text); line-height: 1.2; margin: 0 0 1.25rem;
    }
    .about-sub {
        font-family: 'DM Sans', sans-serif; font-size: 1.1rem;
        color: var(--text-muted); line-height: 1.7; margin: 0;
    }

    .about-section { padding: 4rem 2rem; }
    .about-section--alt { background: var(--surface); }
    .about-container { max-width: 1100px; margin: 0 auto; }
    .about-label {
        font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 600;
        letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal-dark); margin-bottom: 0.75rem;
    }
    .about-heading {
        font-family: 'Poppins', sans-serif; font-size: clamp(1.4rem, 3vw, 1.9rem);
        font-weight: 700; color: var(--text); margin: 0 0 2rem; max-width: 640px;
    }

    /* Mission layout */
    .about-mission { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
    .about-mission-text p { font-family: 'DM Sans', sans-serif; font-size: 0.95rem; color: var(--text-muted); line-height: 1.7; margin: 0 0 1rem; }
    .about-mission-values { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .value-card {
        background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem;
    }
    .value-icon { font-size: 1.5rem; margin-bottom: 0.5rem; }
    .value-card strong { display: block; font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 700; color: var(--text); margin-bottom: 4px; }
    .value-card p { font-family: 'DM Sans', sans-serif; font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

    /* Product grid */
    .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
    .product-card {
        background: var(--white); border: 1px solid var(--border); border-radius: 14px;
        padding: 1.5rem; transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
    }
    .product-card:hover { border-color: var(--teal); box-shadow: 0 4px 16px rgba(0,191,165,0.1); transform: translateY(-2px); }
    .product-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
    .product-icon--teal { background: var(--teal-light); color: var(--teal-dark); }
    .product-icon--navy { background: var(--navy-light); color: var(--navy); }
    .product-icon--orange { background: #FFF3E0; color: #E65100; }
    .product-icon--green { background: #E8F5E9; color: #2E7D32; }
    .product-card h3 { font-family: 'Poppins', sans-serif; font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem; }
    .product-card p { font-family: 'DM Sans', sans-serif; font-size: 0.84rem; color: var(--text-muted); line-height: 1.65; margin: 0 0 1rem; }
    .product-link { font-family: 'DM Sans', sans-serif; font-size: 0.84rem; font-weight: 600; color: var(--teal-dark); text-decoration: none; }
    .product-link:hover { text-decoration: underline; }

    /* Industry list */
    .industry-list { display: flex; flex-direction: column; gap: 1rem; max-width: 640px; }
    .industry-item {
        display: flex; align-items: center; gap: 1rem;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 10px; padding: 1rem 1.25rem;
    }
    .industry-icon { font-size: 1.5rem; flex-shrink: 0; }
    .industry-item div { display: flex; flex-direction: column; gap: 2px; }
    .industry-item strong { font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 700; color: var(--text); }
    .industry-item span { font-family: 'DM Sans', sans-serif; font-size: 0.82rem; color: var(--text-muted); }

    /* CTA */
    .about-cta { padding: 5rem 2rem; background: var(--surface); border-top: 1px solid var(--border); text-align: center; }
    .about-cta-inner { max-width: 600px; margin: 0 auto; }
    .about-cta h2 { font-family: 'Poppins', sans-serif; font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 700; color: var(--text); margin: 0 0 0.75rem; }
    .about-cta p { font-family: 'DM Sans', sans-serif; font-size: 1rem; color: var(--text-muted); margin: 0 0 2rem; line-height: 1.65; }
    .about-cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    .btn-primary {
        background: var(--teal); color: #FFFFFF; font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; font-weight: 700; padding: 0.8rem 1.75rem;
        border-radius: 8px; text-decoration: none; transition: background 0.2s;
    }
    .btn-primary:hover { background: var(--teal-dark); }
    .btn-secondary {
        background: var(--white); color: var(--text); font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; font-weight: 600; padding: 0.8rem 1.75rem;
        border-radius: 8px; text-decoration: none;
        border: 1px solid var(--border); transition: border-color 0.2s, background 0.2s;
    }
    .btn-secondary:hover { border-color: var(--teal); background: var(--teal-light); }

    @@media (max-width: 768px) {
        .about-mission { grid-template-columns: 1fr; gap: 2rem; }
        .about-mission-values { grid-template-columns: 1fr 1fr; }
        .product-grid { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 480px) {
        .about-mission-values, .product-grid { grid-template-columns: 1fr; }
    }
</style>
