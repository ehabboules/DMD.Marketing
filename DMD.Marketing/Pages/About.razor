@page "/about"

<PageTitle>About DMD Tech — Dynamic, Modern, Dedicated</PageTitle>

<!-- Hero -->
<div class="about-hero">
    <div class="about-hero-inner">
        <div class="about-hero-copy">
            <div class="about-eyebrow">About DMD Tech</div>
            <h1 class="about-title">Dynamic. Modern.<br />Dedicated.</h1>
            <p class="about-sub">We build retail software for Canadian businesses — starting with a POS and inventory platform that treats your operation like a first-class concern, not an afterthought.</p>
        </div>
        <div class="about-hero-art">
            <svg viewBox="0 0 400 320" width="400" height="320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
