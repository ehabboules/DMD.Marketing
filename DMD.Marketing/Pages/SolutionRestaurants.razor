                <path d="M238 164 Q240 158 238 152" stroke="#00BFA5" stroke-width="1.5" fill="none" opacity="0.4" stroke-linecap="round"/>
                <path d="M279 168 Q281 162 279 156" stroke="#7C3AED" stroke-width="1.5" fill="none" opacity="0.3" stroke-linecap="round"/>
