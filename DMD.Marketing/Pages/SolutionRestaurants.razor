                <text x="118" y="96" text-anchor="middle" font-family="Poppins, sans-serif" font-size="8" fill="#00BFA5" font-weight="700">$12.99</text>

                <rect x="164" y="72" width="72" height="30" rx="3" fill="#1A237E" opacity="0.6"/>
                <rect x="166" y="74" width="68" height="12" rx="2" fill="#7C3AED" opacity="0.5"/>
                <text x="200" y="84" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="7" fill="white" font-weight="600">Falafel</text>
                <text x="200" y="96" text-anchor="middle" font-family="Poppins, sans-serif" font-size="8" fill="#00BFA5" font-weight="700">$9.99</text>

                <rect x="246" y="72" width="72" height="30" rx="3" fill="#1A237E" opacity="0.6"/>
                <rect x="248" y="74" width="68" height="12" rx="2" fill="#00BFA5" opacity="0.4"/>
