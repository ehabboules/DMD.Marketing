@page "/restaurants"

<PageTitle>Restaurant POS & Inventory — DMD Inventory</PageTitle>

<!-- Hero -->
<div class="sol-hero">
    <div class="sol-hero-inner">
        <div class="sol-hero-copy">
            <div class="sol-eyebrow sol-eyebrow--purple">
                <span class="sol-eyebrow-dot sol-eyebrow-dot--purple"></span>
                For Restaurants &amp; Quick-Service
            </div>
            <h1 class="sol-title">POS and inventory for<br />quick-service restaurants.</h1>
            <p class="sol-sub">DMD Inventory is built for retail — but quick-service restaurants, food counters, and cafés have successfully run on it for order-taking, item tracking, and daily financial reporting.</p>
            <div class="sol-hero-actions">
                <a href="/register" class="btn-primary">Start free 14-day trial</a>
                <a href="/contact" class="btn-secondary">Ask us anything</a>
            </div>
        </div>
