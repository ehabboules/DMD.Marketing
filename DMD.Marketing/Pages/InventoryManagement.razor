<!-- Features -->
<section class="pg-section">
    <div class="pg-container">
        <div class="pg-section-header">
            <h2 class="pg-heading">Full inventory control in one platform</h2>
            <p class="pg-heading-sub">From product setup to warehouse transfers — everything you need to know what you have and where it is.</p>
        </div>
        <div class="pg-feat-grid">

            <div class="pg-feat-card pg-feat-card--wide">
                <div class="pg-feat-icon pg-feat-icon--navy">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <h3>Multi-Warehouse Stock</h3>
                <p>View stock levels across all your warehouses in a single screen. Filter by location, product, or status. Make manual adjustments with a reason log. Export to Excel for your accountant or operations team.</p>
                <ul class="feat-list">
                    <li>Per-warehouse stock view</li>
                    <li>Unified total across all locations</li>
                    <li>Manual stock adjustments with reason codes</li>
                    <li>Excel export</li>
                </ul>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--navy">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48 2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83"/></svg>
                </div>
                <h3>Products & Categories</h3>
                <p>Add products with images, pricing, categories, tax settings, and age restriction flags. Supports whole and decimal quantity display based on your business type.</p>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--navy">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                </div>
                <h3>Stock Movement Log</h3>
                <p>Every inventory in and out is logged with a reference number, timestamp, source (sale, return, PO, adjustment), and user. Your inventory is always explainable.</p>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--navy">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
                </div>
                <h3>Low Stock Alerts</h3>
                <p>Set minimum stock thresholds per product. The dashboard surfaces low-stock items immediately. Know what needs reordering before your shelves are empty.</p>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--navy">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                </div>
                <h3>Inventory Valuation</h3>
                <p>Know the current value of your stock at any time, based on last purchase costs across all warehouses. No manual spreadsheet needed.</p>
            </div>

            <div class="pg-feat-card">
                <div class="pg-feat-icon pg-feat-icon--navy">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                </div>
                <h3>Product Images</h3>
                <p>Upload product photos stored on Cloudflare R2. Images appear in POS search results for faster identification by your cashiers and staff.</p>
            </div>

        </div>
    </div>
</section>

<!-- How it connects -->
<section class="pg-section pg-section--alt">
    <div class="pg-container">
        <div class="pg-section-header">
            <h2 class="pg-heading">Inventory that updates itself</h2>
            <p class="pg-heading-sub">Stock levels change automatically as you sell, receive, and return — no manual sync needed.</p>
        </div>
        <div class="flow-grid">
            <div class="flow-item">
                <div class="flow-icon flow-icon--sale">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                </div>
                <div class="flow-label">POS Sale</div>
                <div class="flow-arrow">→</div>
                <div class="flow-effect">Stock decremented</div>
            </div>
            <div class="flow-item">
                <div class="flow-icon flow-icon--return">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                </div>
                <div class="flow-label">Return</div>
                <div class="flow-arrow">→</div>
                <div class="flow-effect">Stock restored</div>
            </div>
            <div class="flow-item">
                <div class="flow-icon flow-icon--po">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </div>
                <div class="flow-label">Receive Stock</div>
                <div class="flow-arrow">→</div>
                <div class="flow-effect">Stock incremented</div>
            </div>
            <div class="flow-item">
                <div class="flow-icon flow-icon--adjust">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </div>
                <div class="flow-label">Adjustment</div>
                <div class="flow-arrow">→</div>
                <div class="flow-effect">Logged with reason</div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="pg-cta">
    <div class="pg-container pg-cta-inner">
        <h2>Know exactly what you have, always.</h2>
        <p>14-day free trial. No credit card required.</p>
        <div class="pg-cta-buttons">
            <a href="/register" class="btn-primary">Start free trial</a>
            <a href="/pricing" class="btn-secondary">View pricing</a>
        </div>
    </div>
</section>

<style>
    :root {
        --teal: #00BFA5; --teal-dark: #00897B; --teal-light: #E0F7F4;
        --navy: #1A237E; --navy-light: #E8EAF6;
        --text: #1C1C1E; --text-muted: #6B7280;
        --border: #E5E7EB; --surface: #F9FAFB; --white: #FFFFFF;
    }

    .pg-hero {
        background: #FFFFFF; border-bottom: 1px solid var(--border);
        padding: 5rem 2rem 4rem;
        position: relative; overflow: hidden;
    }
    .pg-hero::after {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse 70% 55% at 50% 100%, rgba(26,35,126,0.05) 0%, transparent 65%);
        pointer-events: none;
    }
    .pg-hero-inner { position: relative; max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
    .pg-hero-copy { text-align: left; }
    .pg-hero-art { display: flex; justify-content: center; align-items: center; }
    @@media (max-width: 768px) { .pg-hero-inner { grid-template-columns: 1fr; } .pg-hero-art { display: none; } }
    .pg-eyebrow {
        display: inline-block; background: var(--navy-light); color: var(--navy);
        font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 600;
        letter-spacing: 0.1em; text-transform: uppercase;
        padding: 0.35rem 1rem; border-radius: 20px;
        border: 1px solid rgba(26,35,126,0.2); margin-bottom: 1.5rem;
    }
    .pg-title {
        font-family: 'Poppins', sans-serif; font-size: 2.75rem;
        font-weight: 700; color: var(--text); line-height: 1.2; margin: 0 0 1.25rem;
    }
    .pg-sub {
        font-family: 'DM Sans', sans-serif; font-size: 1.1rem;
        color: var(--text-muted); line-height: 1.7; margin: 0 0 2rem;
    }
    .pg-hero-actions { display: flex; gap: 1rem; justify-content: flex-start; flex-wrap: wrap; }

    .pg-section { padding: 4rem 2rem; }
    .pg-section--alt { background: var(--surface); }
    .pg-container { max-width: 1100px; margin: 0 auto; }

    .pg-section-header { text-align: center; margin-bottom: 3rem; }
    .pg-heading { font-family: 'Poppins', sans-serif; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--text); margin: 0 0 0.75rem; }
    .pg-heading-sub { font-family: 'DM Sans', sans-serif; font-size: 1rem; color: var(--text-muted); max-width: 560px; margin: 0 auto; }

    .pg-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .pg-feat-card--wide { grid-column: span 2; }
    .pg-feat-card {
        background: var(--white); border: 1px solid var(--border); border-radius: 14px;
        padding: 1.5rem; transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
    }
    .pg-feat-card:hover { border-color: var(--navy); box-shadow: 0 4px 20px rgba(26,35,126,0.08); transform: translateY(-2px); }
    .pg-feat-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
    .pg-feat-icon--navy { background: var(--navy-light); color: var(--navy); }
    .pg-feat-card h3 { font-family: 'Poppins', sans-serif; font-size: 1rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem; }
    .pg-feat-card p { font-family: 'DM Sans', sans-serif; font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; margin: 0 0 0.75rem; }

    .feat-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
    .feat-list li { font-family: 'DM Sans', sans-serif; font-size: 0.84rem; color: var(--text-muted); padding-left: 1.25rem; position: relative; }
    .feat-list li::before { content: '✓'; position: absolute; left: 0; color: var(--teal); font-weight: 700; }

    /* Flow diagram */
    .flow-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.5rem; }
    .flow-item {
        background: var(--white); border: 1px solid var(--border); border-radius: 14px;
        padding: 1.5rem; text-align: center;
    }
    .flow-icon {
        width: 48px; height: 48px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1rem;
    }
    .flow-icon--sale { background: #E0F7F4; color: #00897B; }
    .flow-icon--return { background: #FEF3C7; color: #D97706; }
    .flow-icon--po { background: #E8EAF6; color: #1A237E; }
    .flow-icon--adjust { background: #F3E5F5; color: #7B1FA2; }
    .flow-label { font-family: 'Poppins', sans-serif; font-size: 0.9rem; font-weight: 700; color: var(--text); margin-bottom: 0.5rem; }
    .flow-arrow { font-size: 1.25rem; color: var(--text-muted); margin: 0.25rem 0; }
    .flow-effect { font-family: 'DM Sans', sans-serif; font-size: 0.8rem; color: var(--teal-dark); font-weight: 600; }

    .pg-cta { padding: 5rem 2rem; background: var(--surface); border-top: 1px solid var(--border); text-align: center; }
    .pg-cta-inner { max-width: 560px; margin: 0 auto; }
    .pg-cta h2 { font-family: 'Poppins', sans-serif; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--text); margin: 0 0 0.75rem; }
    .pg-cta p { font-family: 'DM Sans', sans-serif; font-size: 1rem; color: var(--text-muted); margin: 0 0 2rem; }
    .pg-cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    .btn-primary {
        background: var(--teal); color: #FFFFFF; font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; font-weight: 700; padding: 0.8rem 1.75rem;
        border-radius: 8px; text-decoration: none; transition: background 0.2s;
    }
    .btn-primary:hover { background: var(--teal-dark); }
    .btn-secondary {
        background: var(--white); color: var(--text); font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; font-weight: 600; padding: 0.8rem 1.75rem;
        border-radius: 8px; text-decoration: none;
        border: 1px solid var(--border); transition: border-color 0.2s, background 0.2s;
    }
    .btn-secondary:hover { border-color: var(--teal); background: var(--teal-light); }

    @@media (max-width: 768px) {
        .pg-feat-grid { grid-template-columns: 1fr; }
        .pg-feat-card--wide { grid-column: span 1; }
        .flow-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 480px) {
        .flow-grid { grid-template-columns: 1fr; }
    }
</style>
