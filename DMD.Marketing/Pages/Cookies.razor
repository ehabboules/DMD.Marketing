@* Needs interactivity for the consent buttons *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime JS

@code {
    // ── Update whenever the Cookie Policy is revised ───────────────────────
    [Parameter] public DateTime LastUpdated { get; set; } = new DateTime(2026, 5, 25);

    private bool _consentUpdated = false;

    private record TocEntry(string Id, string Num, string LabelEn, string LabelFr);

    private static readonly TocEntry[] _sections =
    [
        new("what-are-cookies",  "1", "What Are Cookies?",        "Qu'est-ce qu'un témoin?"),
        new("cookies-we-use",    "2", "Cookies We Use",           "Témoins utilisés"),
        new("google-fonts",      "3", "Google Fonts",             "Google Fonts"),
        new("browser-storage",   "4", "Browser Storage",          "Stockage navigateur"),
        new("your-choices",      "5", "Your Choices",             "Vos choix"),
        new("contact",           "6", "Contact Us",               "Nous contacter"),
    ];

    private async Task UpdateConsent(string value)
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "dmd_cookie_consent", value);
        _consentUpdated = true;
    }
}
