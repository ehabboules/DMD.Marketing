@page "/retail"

<PageTitle>Retail Store POS & Inventory — Cloud Mobil POS</PageTitle>

<!-- Hero -->
<div class="sol-hero">
    <div class="sol-hero-inner">
        <div class="sol-hero-copy">
            <div class="sol-eyebrow sol-eyebrow--teal">
                <span class="sol-eyebrow-dot sol-eyebrow-dot--teal"></span>
                For Canadian Retail Stores
            </div>
            <h1 class="sol-title">The all-in-one system your<br />retail store has been waiting for.</h1>
            <p class="sol-sub">From the moment a customer walks in to your monthly financial close — Cloud Mobil POS manages your POS, stock, purchasing, and reports in one platform built specifically for Canadian retail.</p>
            <div class="sol-hero-actions">
                <a href="/register" class="btn-primary">Start free 14-day trial</a>
                <a href="/contact" class="btn-secondary">Book a demo</a>
            </div>
        </div>
        <div class="sol-hero-art">
            <svg viewBox="0 0 400 320" width="400" height="320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
