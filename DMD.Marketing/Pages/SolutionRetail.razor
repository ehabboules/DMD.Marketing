                <rect x="118" y="76" width="80" height="8" rx="2" fill="#00BFA5"/>
                <rect x="206" y="76" width="40" height="8" rx="2" fill="#E0F7F4"/>
                <!-- Door -->
                <rect x="165" y="190" width="70" height="90" rx="4" fill="#1A237E" opacity="0.15"/>
                <rect x="167" y="192" width="66" height="88" rx="3" fill="white" opacity="0.6"/>
                <circle cx="226" cy="237" r="4" fill="#00BFA5"/>
                <!-- Left shelf unit -->
                <rect x="80" y="110" width="72" height="60" rx="3" fill="white" opacity="0.8"/>
                <rect x="80" y="128" width="72" height="2" fill="#E5E7EB"/>
                <rect x="80" y="146" width="72" height="2" fill="#E5E7EB"/>
                <!-- Shelf products left -->
                <rect x="85" y="115" width="14" height="12" rx="2" fill="#00BFA5"/>
                <rect x="103" y="117" width="10" height="10" rx="2" fill="#E0F7F4"/>
                <rect x="117" y="113" width="12" height="14" rx="2" fill="#1A237E" opacity="0.5"/>
                <rect x="85" y="132" width="10" height="13" rx="2" fill="#E0F7F4"/>
                <rect x="99" y="133" width="12" height="12" rx="2" fill="#00BFA5" opacity="0.6"/>
                <rect x="115" y="131" width="14" height="14" rx="2" fill="#1A237E" opacity="0.3"/>
                <rect x="85" y="150" width="16" height="15" rx="2" fill="#00BFA5" opacity="0.4"/>
                <rect x="105" y="151" width="12" height="14" rx="2" fill="#E0F7F4"/>
                <!-- Right shelf unit -->
                <rect x="248" y="110" width="72" height="60" rx="3" fill="white" opacity="0.8"/>
                <rect x="248" y="128" width="72" height="2" fill="#E5E7EB"/>
                <rect x="248" y="146" width="72" height="2" fill="#E5E7EB"/>
                <!-- Shelf products right -->
                <rect x="253" y="114" width="12" height="13" rx="2" fill="#1A237E" opacity="0.4"/>
                <rect x="269" y="115" width="10" height="12" rx="2" fill="#00BFA5"/>
                <rect x="283" y="113" width="14" height="14" rx="2" fill="#E0F7F4"/>
                <rect x="254" y="132" width="14" height="13" rx="2" fill="#00BFA5" opacity="0.5"/>
                <rect x="272" y="131" width="10" height="14" rx="2" fill="#E0F7F4"/>
                <rect x="286" y="133" width="12" height="12" rx="2" fill="#1A237E" opacity="0.3"/>
                <rect x="253" y="150" width="12" height="15" rx="2" fill="#E0F7F4"/>
                <rect x="269" y="149" width="14" height="16" rx="2" fill="#00BFA5" opacity="0.7"/>
                <!-- POS counter -->
                <rect x="80" y="180" width="70" height="30" rx="4" fill="#1A237E" opacity="0.08"/>
                <rect x="83" y="183" width="60" height="22" rx="3" fill="#1A237E" opacity="0.15"/>
                <!-- Screen on counter -->
                <rect x="88" y="186" width="36" height="16" rx="2" fill="#00BFA5" opacity="0.9"/>
                <rect x="91" y="189" width="24" height="2" rx="1" fill="white"/>
                <rect x="91" y="193" width="18" height="2" rx="1" fill="white" opacity="0.7"/>
