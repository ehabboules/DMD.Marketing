        <MudGrid Spacing="6" AlignItems="AlignItems.Start">

            <!-- ── Sticky Table of Contents (hidden on mobile) ── -->
            <MudItem xs="12" md="3" Class="tos-toc-wrap" Style="align-self:start;position:sticky;top:84px;">
                <nav class="tos-toc" aria-label="@(isFr ? "Table des matières" : "Table of contents")">
                    <p class="tos-toc-heading">@(isFr ? "Sommaire" : "On this page")</p>
                    @foreach (var s in _sections)
                    {
                        <a href="#@s.Id" class="tos-toc-link">
                            <span class="tos-toc-num">@s.Num</span>
                            <span>@(isFr ? s.LabelFr : s.LabelEn)</span>
                        </a>
                    }
                </nav>
            </MudItem>

