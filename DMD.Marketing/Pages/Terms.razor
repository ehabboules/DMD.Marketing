@page "/terms"
@page "/terms/en"
@page "/terms/fr"
@inject NavigationManager Nav
@inject IConfiguration Config

@{
    var isFr         = Nav.Uri.Contains("/terms/fr", StringComparison.OrdinalIgnoreCase);
    var privacyUrl   = isFr ? "/privacy/fr" : "/privacy/en";
    var contactEmail = Config["SendGrid:ToEmail"] ?? "hello@cloudmpos.com";
    var updatedStr   = LastUpdated.ToString(
        isFr ? "d MMMM yyyy" : "MMMM d, yyyy",
        new System.Globalization.CultureInfo(isFr ? "fr-CA" : "en-CA"));
}

<PageTitle>@(isFr ? "Conditions d'utilisation" : "Terms of Service") — Cloud Mobil POS</PageTitle>

<!-- ══════════════════════════════════════════════════════════════
     HERO HEADER
════════════════════════════════════════════════════════════════ -->
<div class="tos-hero">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="tos-hero-inner">
            <div>
                <p class="tos-eyebrow">@(isFr ? "Juridique" : "Legal")</p>
                <h1 class="tos-hero-title">
                    @(isFr ? "Conditions d'utilisation" : "Terms of Service")
                </h1>
                <p class="tos-hero-meta">
                    @(isFr ? "Dernière mise à jour" : "Last updated"):
                    <strong>@updatedStr</strong>
                    &nbsp;·&nbsp;
                    @(isFr ? "Droit applicable : Ontario, Canada" : "Governing law: Ontario, Canada")
                </p>
            </div>

            <!-- Language toggle -->
            <div class="tos-lang-toggle" role="group" aria-label="Language / Langue">
                <a href="/terms/en" class="tos-lang-btn @(!isFr ? "tos-lang-active" : "")"
                   aria-current="@(!isFr ? "page" : "false")">EN</a>
                <span class="tos-lang-sep" aria-hidden="true">|</span>
                <a href="/terms/fr" class="tos-lang-btn @(isFr ? "tos-lang-active" : "")"
                   aria-current="@(isFr ? "page" : "false")">FR</a>
            </div>
        </div>
    </MudContainer>
</div>

<!-- ══════════════════════════════════════════════════════════════
     BODY: STICKY TOC + CONTENT
════════════════════════════════════════════════════════════════ -->
<section class="section section-gray">
