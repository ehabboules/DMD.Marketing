@page "/reports-analytics"

<PageTitle>Reports & Analytics — DMD Inventory</PageTitle>

<!-- Hero -->
<div class="pg-hero">
    <div class="pg-hero-inner">
        <div class="pg-eyebrow">Reports & Analytics</div>
        <h1 class="pg-title">Data that drives decisions.<br />No spreadsheets required.</h1>
        <p class="pg-sub">Sales transactions, product profitability, inventory valuation, tax reports, and net income — all built into the platform. Understand your business without leaving DMD.</p>
        <div class="pg-hero-actions">
            <a href="/register" class="btn-primary">Try free for 14 days</a>
            <a href="/features" class="btn-secondary">See all features</a>
        </div>
    </div>
</div>

<!-- Report categories -->
<section class="pg-section">
    <div class="pg-container">
        <div class="pg-section-header">
            <h2 class="pg-heading">Every report your retail business needs</h2>
            <p class="pg-heading-sub">Built for Canadian retailers — revenue, cost, tax, and stock in one place.</p>
        </div>

        <!-- Sales Reports -->
        <div class="report-group">
            <div class="report-group-header">
                <div class="rg-icon rg-icon--blue">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                </div>
                <div>
                    <h3>Sales Reports</h3>
                    <p>Understand what you're selling, when, and at what margin.</p>
                </div>
            </div>
            <div class="report-cards">
                <div class="report-card">
                    <h4>Sales Transactions</h4>
                    <p>View all transactions for Today, Yesterday, This Week, This Month, or any custom date range. Drill into any order directly from the list.</p>
                </div>
                <div class="report-card">
                    <h4>Sales Summary</h4>
                    <p>Aggregate units sold, revenue, discounts applied, and taxes collected over any period. One screen, all the numbers that matter.</p>
                </div>
                <div class="report-card">
                    <h4>Product Profitability</h4>
                    <p>See which products are your best margin performers and which are underperforming. Make smarter purchasing and pricing decisions.</p>
                </div>
            </div>
        </div>

        <!-- Financial Reports -->
        <div class="report-group">
            <div class="report-group-header">
                <div class="rg-icon rg-icon--green">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                    <h3>Financial Reports</h3>
                    <p>Revenue, expenses, and net income — without needing an accountant to pull it together.</p>
                </div>
            </div>
            <div class="report-cards">
                <div class="report-card">
                    <h4>Net Income Report</h4>
                    <p>Revenue minus expenses, broken down by period. Understand profitability without leaving the platform.</p>
                </div>
                <div class="report-card">
                    <h4>Expense Tracking</h4>
                    <p>Log and categorize business expenses. Filter and review spending over any period to understand where your money is going.</p>
                </div>
                <div class="report-card">
                    <h4>Financial Dashboard</h4>
                    <p>Admin-only overview of total revenue, total spend, and net income at a glance. Drill down into any period from a single screen.</p>
                </div>
            </div>
        </div>

        <!-- Inventory Reports -->
        <div class="report-group">
            <div class="report-group-header">
                <div class="rg-icon rg-icon--navy">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <div>
                    <h3>Inventory Reports</h3>
                    <p>Know the value and state of your stock at any point in time.</p>
                </div>
            </div>
            <div class="report-cards">
                <div class="report-card">
                    <h4>Inventory Valuation</h4>
                    <p>Current stock value across all warehouses based on last purchase cost. Essential for year-end and regular profitability reviews.</p>
                </div>
                <div class="report-card">
                    <h4>Stock Movement Log</h4>
                    <p>Every inventory movement logged with reference, timestamp, source, and user. Your inventory is always fully auditable.</p>
                </div>
                <div class="report-card">
                    <h4>Low Stock Overview</h4>
                    <p>Dashboard view of all products below their reorder threshold. Know what to reorder before stockouts affect sales.</p>
                </div>
            </div>
        </div>

        <!-- Tax Reports -->
        <div class="report-group">
            <div class="report-group-header">
                <div class="rg-icon rg-icon--teal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                </div>
                <div>
                    <h3>Tax Reports</h3>
                    <p>GST and PST collected, ready for your accountant or CRA filing.</p>
                </div>
            </div>
            <div class="report-cards">
                <div class="report-card">
                    <h4>Tax Report</h4>
                    <p>GST and provincial PST collected over any date range, broken down by rate. Export to Excel for your accountant.</p>
                </div>
                <div class="report-card">
                    <h4>Excel Exports</h4>
                    <p>Export purchase orders, sales orders, and stock data to Excel. Every report that can be exported has a one-click download.</p>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- CTA -->
<section class="pg-cta">
    <div class="pg-container pg-cta-inner">
        <h2>Stop guessing. Start knowing.</h2>
        <p>14-day free trial. No credit card required.</p>
        <div class="pg-cta-buttons">
            <a href="/register" class="btn-primary">Start free trial</a>
            <a href="/pricing" class="btn-secondary">View pricing</a>
        </div>
    </div>
</section>

<style>
    :root {
        --teal: #00BFA5; --teal-dark: #00897B; --teal-light: #E0F7F4;
        --navy: #1A237E; --navy-light: #E8EAF6;
        --text: #1C1C1E; --text-muted: #6B7280;
        --border: #E5E7EB; --surface: #F9FAFB; --white: #FFFFFF;
    }

    .pg-hero {
        background: #FFFFFF; border-bottom: 1px solid var(--border);
        padding: 5rem 2rem 4rem; text-align: center;
        position: relative; overflow: hidden;
    }
    .pg-hero::after {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse 70% 55% at 50% 100%, rgba(0,191,165,0.07) 0%, transparent 65%);
        pointer-events: none;
    }
    .pg-hero-inner { position: relative; max-width: 700px; margin: 0 auto; }
    .pg-eyebrow {
        display: inline-block; background: #E3F2FD; color: #1565C0;
        font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 600;
        letter-spacing: 0.1em; text-transform: uppercase;
        padding: 0.35rem 1rem; border-radius: 20px;
        border: 1px solid rgba(21,101,192,0.2); margin-bottom: 1.5rem;
    }
    .pg-title {
        font-family: 'Poppins', sans-serif; font-size: 2.75rem;
        font-weight: 700; color: var(--text); line-height: 1.2; margin: 0 0 1.25rem;
    }
    .pg-sub {
        font-family: 'DM Sans', sans-serif; font-size: 1.1rem;
        color: var(--text-muted); line-height: 1.7; margin: 0 0 2rem;
    }
    .pg-hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    .pg-section { padding: 4rem 2rem; }
    .pg-container { max-width: 1100px; margin: 0 auto; }

    .pg-section-header { text-align: center; margin-bottom: 3rem; }
    .pg-heading { font-family: 'Poppins', sans-serif; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--text); margin: 0 0 0.75rem; }
    .pg-heading-sub { font-family: 'DM Sans', sans-serif; font-size: 1rem; color: var(--text-muted); max-width: 560px; margin: 0 auto; }

    /* Report groups */
    .report-group { margin-bottom: 3rem; }
    .report-group:last-child { margin-bottom: 0; }
    .report-group-header {
        display: flex; align-items: flex-start; gap: 1rem;
        margin-bottom: 1.25rem;
    }
    .rg-icon {
        width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; margin-top: 2px;
    }
    .rg-icon--blue { background: #E3F2FD; color: #1565C0; }
    .rg-icon--green { background: #E8F5E9; color: #2E7D32; }
    .rg-icon--navy { background: var(--navy-light); color: var(--navy); }
    .rg-icon--teal { background: var(--teal-light); color: var(--teal-dark); }
    .report-group-header h3 { font-family: 'Poppins', sans-serif; font-size: 1.15rem; font-weight: 700; color: var(--text); margin: 0 0 4px; }
    .report-group-header p { font-family: 'DM Sans', sans-serif; font-size: 0.875rem; color: var(--text-muted); margin: 0; }

    .report-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
    .report-card {
        background: var(--white); border: 1px solid var(--border); border-radius: 12px;
        padding: 1.25rem 1.5rem; transition: box-shadow 0.2s, border-color 0.2s;
    }
    .report-card:hover { border-color: var(--teal); box-shadow: 0 4px 16px rgba(0,191,165,0.08); }
    .report-card h4 { font-family: 'Poppins', sans-serif; font-size: 0.9rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem; }
    .report-card p { font-family: 'DM Sans', sans-serif; font-size: 0.85rem; color: var(--text-muted); line-height: 1.65; margin: 0; }

    .pg-cta { padding: 5rem 2rem; background: var(--surface); border-top: 1px solid var(--border); text-align: center; }
    .pg-cta-inner { max-width: 560px; margin: 0 auto; }
    .pg-cta h2 { font-family: 'Poppins', sans-serif; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--text); margin: 0 0 0.75rem; }
    .pg-cta p { font-family: 'DM Sans', sans-serif; font-size: 1rem; color: var(--text-muted); margin: 0 0 2rem; }
    .pg-cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    .btn-primary {
        background: var(--teal); color: #FFFFFF; font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; font-weight: 700; padding: 0.8rem 1.75rem;
        border-radius: 8px; text-decoration: none; transition: background 0.2s;
    }
    .btn-primary:hover { background: var(--teal-dark); }
    .btn-secondary {
        background: var(--white); color: var(--text); font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; font-weight: 600; padding: 0.8rem 1.75rem;
        border-radius: 8px; text-decoration: none;
        border: 1px solid var(--border); transition: border-color 0.2s, background 0.2s;
    }
    .btn-secondary:hover { border-color: var(--teal); background: var(--teal-light); }

    @@media (max-width: 640px) {
        .report-cards { grid-template-columns: 1fr; }
    }
</style>
