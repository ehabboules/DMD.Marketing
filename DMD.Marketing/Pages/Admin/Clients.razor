@page "/admin/clients"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DMD.Marketing.Services
@using DMD.Marketing.Data
@using DMD.Marketing.Models
@using DMD.Marketing.Components.Admin
@inject AdminClientService AdminService
@inject ProvisioningService ProvisioningService
@inject EmailService EmailService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

@if (_authChecked)
{
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">

    <!-- ── Header ────────────────────────────────────────────── -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h4">Client Management</MudText>
            <MudText Typo="Typo.body2" Color="Color.Inherit">Billing, activation, renewals and demo tenants</MudText>
        </div>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.PersonAdd" Variant="Variant.Filled"
                   Color="Color.Primary" OnClick="OpenCreateClientAsync" Disabled="_loading">
            + New Client
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined"
                   Color="Color.Primary" OnClick="LoadAsync" Disabled="_loading">
            Refresh
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="my-4">@_loadError</MudAlert>
    }
    else
    {
        <!-- ── Stat cards ───────────────────────────────────────── -->
        <MudGrid Spacing="3" Class="mb-5">
            <MudItem xs="6" sm="2">
                <MudPaper Elevation="2" Class="pa-3" Style="border-radius:14px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">Total</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">@_summary.Total</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudPaper Elevation="2" Class="pa-3" Style="border-radius:14px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">Active</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Success" Class="font-weight-bold">@_summary.Active</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudPaper Elevation="2" Class="pa-3" Style="border-radius:14px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">Pending</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Warning" Class="font-weight-bold">@_summary.Pending</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Color="Color.Warning" Size="Size.Large" />
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudPaper Elevation="2" Class="pa-3"
                          Style="@($"border-radius:14px;{(_summary.ExpiringSoon > 0 ? "border:2px solid #FF9800;" : "")}")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">Expiring Soon</MudText>
                            <MudText Typo="Typo.h4" Color="@(_summary.ExpiringSoon > 0 ? Color.Warning : Color.Inherit)"
                                     Class="font-weight-bold">@_summary.ExpiringSoon</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.EventRepeat"
                                 Color="@(_summary.ExpiringSoon > 0 ? Color.Warning : Color.Inherit)"
                                 Size="Size.Large" />
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudPaper Elevation="2" Class="pa-3" Style="border-radius:14px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">Revenue / Mo</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Class="font-weight-bold">
                                $@_revenueThisMonth.ToString("N0")
                            </MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" Size="Size.Large" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- ── Demo Tenants ────────────────────────────────────── -->
        <MudPaper Elevation="2" Class="pa-4 mb-5" Style="border-radius:14px;border-left:4px solid #00BFA5;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Science" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Demo Tenants</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Live</MudChip>
            </MudStack>
            <MudGrid Spacing="3">
                @foreach (var demo in _demoTenants)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Elevation="1" Class="pa-3" Style="border-radius:10px;background:#F9FAFB;border:1px solid #E5E7EB;">
                            <MudStack Spacing="1" Class="mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body1" Class="font-weight-bold">@demo.StoreName</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Live</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Inherit">
                                    slug: <strong>@demo.Slug</strong> · @demo.Plan · @demo.Type
                                </MudText>
                            </MudStack>
                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           EndIcon="@Icons.Material.Filled.OpenInNew"
                                           Href="@($"https://{demo.Slug}.cloudmpos.com")" Target="_blank">
                                    Visit Demo
                                </MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                           StartIcon="@(_seeding.Contains(demo.Slug) ? null : Icons.Material.Filled.Refresh)"
                                           Disabled="_seeding.Contains(demo.Slug)"
                                           OnClick="@(() => SeedTenantAsync(demo.Slug))">
                                    @if (_seeding.Contains(demo.Slug))
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                    }
                                    Re-seed
                                </MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                           StartIcon="@(_migrating ? null : Icons.Material.Filled.Storage)"
                                           Disabled="_migrating"
                                           OnClick="RunMigrationsAsync">
                                    @if (_migrating)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                    }
                                    Run Migrations
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <!-- ── Upcoming Renewals ───────────────────────────────── -->
        @if (_upcomingRenewals.Count > 0)
        {
            <MudPaper Elevation="2" Class="pa-4 mb-5" Style="border-radius:14px;border-left:4px solid #FF9800;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.EventRepeat" Color="Color.Warning" />
                    <MudText Typo="Typo.h6">Upcoming Renewals</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                        @_upcomingRenewals.Count client@(_upcomingRenewals.Count == 1 ? "" : "s")
                    </MudChip>
                </MudStack>
                <MudGrid Spacing="2">
                    @foreach (var u in _upcomingRenewals.OrderBy(u => u.SubscriptionExpiresAt))
                    {
                        var days = (int)Math.Ceiling((u.SubscriptionExpiresAt!.Value - DateTime.UtcNow).TotalDays);
                        var urgent = days <= 7;
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Elevation="0" Class="pa-3"
                                      Style="@($"border-radius:10px;background:{(urgent ? "#FFF3E0" : "#FAFAFA")};border:1px solid {(urgent ? "#FFB74D" : "#E5E7EB")};")">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">@(u.StoreName ?? u.Email)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Inherit">@u.Email</MudText>
                                        <MudText Typo="Typo.caption">@u.SelectedPlan · @u.BillingCycle</MudText>
                                    </div>
                                    <MudStack AlignItems="AlignItems.End">
                                        <MudText Typo="Typo.body2" Color="@(urgent ? Color.Error : Color.Warning)"
                                                 Class="font-weight-bold">
                                            @days day@(days == 1 ? "" : "s")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Inherit">
                                            @u.SubscriptionExpiresAt!.Value.ToString("MMM d")
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        }

        <!-- ── Pending Requests ────────────────────────────────── -->
        <MudPaper Elevation="2" Class="mb-5" Style="border-radius:12px;overflow:hidden;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3" Style="border-bottom:1px solid #e5e7eb;">
                <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Color="Color.Warning" />
                <MudText Typo="Typo.h6">Pending Requests</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                    @_pendingUsers.Count
                </MudChip>
            </MudStack>
            <MudTable Items="@_pendingUsers" Hover="true" Dense="false" Elevation="0" Breakpoint="Breakpoint.Md">
                <HeaderContent>
                    <MudTh Style="font-weight:600;">Name</MudTh>
                    <MudTh Style="font-weight:600;">Email</MudTh>
                    <MudTh Style="font-weight:600;">Store Name</MudTh>
                    <MudTh Style="font-weight:600;">Plan</MudTh>
                    <MudTh Style="font-weight:600;">Business Type</MudTh>
                    <MudTh Style="font-weight:600;">Requested</MudTh>
                    <MudTh Style="font-weight:600;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudText Typo="Typo.body2">@context.FirstName @context.LastName</MudText>
                    </MudTd>
                    <MudTd DataLabel="Email">
                        <MudText Typo="Typo.caption">@context.Email</MudText>
                    </MudTd>
                    <MudTd DataLabel="Store Name">
                        <MudText Typo="Typo.body2">@(context.StoreName ?? "—")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Plan">
                        @if (context.SelectedPlan == PlanSlug.None)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="Color.Default" Variant="Variant.Outlined">
                                No plan selected
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="Color.Primary" Variant="Variant.Outlined">
                                @context.SelectedPlan
                            </MudChip>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">@context.BillingCycle</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Business Type">
                        <MudText Typo="Typo.caption">@(context.BusinessType ?? "—")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Requested">
                        <MudText Typo="Typo.caption">@context.CreatedAt.ToString("MMM d, yyyy")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        @if (string.IsNullOrEmpty(context.TenantSlug))
                        {
                            <MudTooltip Text="Provision database">
                                <MudIconButton Icon="@Icons.Material.Filled.Storage"
                                               Color="Color.Primary" Size="Size.Medium"
                                               OnClick="@(() => OpenProvisionWizardAsync(context))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Activate client (manual)">
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Color="Color.Success" Size="Size.Medium"
                                           OnClick="@(() => ActivateClientAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="View details">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                           Color="Color.Primary" Size="Size.Medium"
                                           OnClick="@(() => ViewDetailsAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">No pending requests.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        <!-- ── Active Clients ──────────────────────────────────── -->
        <MudPaper Elevation="2" Class="mb-5" Style="border-radius:12px;overflow:hidden;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3" Style="border-bottom:1px solid #e5e7eb;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                <MudText Typo="Typo.h6">Active Clients</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                    @_activeUsers.Count
                </MudChip>
            </MudStack>
            <MudTable Items="@_activeUsers" Hover="true" Dense="false" Elevation="0" Breakpoint="Breakpoint.Md">
                <HeaderContent>
                    <MudTh Style="font-weight:600;">Name</MudTh>
                    <MudTh Style="font-weight:600;">Email</MudTh>
                    <MudTh Style="font-weight:600;">Store Name</MudTh>
                    <MudTh Style="font-weight:600;">Plan</MudTh>
                    <MudTh Style="font-weight:600;">Expiry</MudTh>
                    <MudTh Style="font-weight:600;">App URL</MudTh>
                    <MudTh Style="font-weight:600;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudText Typo="Typo.body2">@context.FirstName @context.LastName</MudText>
                    </MudTd>
                    <MudTd DataLabel="Email">
                        <MudText Typo="Typo.caption">@context.Email</MudText>
                    </MudTd>
                    <MudTd DataLabel="Store Name">
                        <MudText Typo="Typo.body2">@(context.StoreName ?? "—")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Plan">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                            @context.SelectedPlan
                        </MudChip>
                        <MudText Typo="Typo.caption" Color="Color.Inherit">@context.BillingCycle</MudText>
                    </MudTd>
                    <MudTd DataLabel="Expiry">
                        @if (context.SubscriptionExpiresAt.HasValue)
                        {
                            var days = (int)Math.Ceiling((context.SubscriptionExpiresAt.Value - DateTime.UtcNow).TotalDays);
                            <MudText Typo="Typo.body2"
                                     Color="@(days <= 0 ? Color.Error : days <= 7 ? Color.Error : days <= 30 ? Color.Warning : Color.Success)">
                                @context.SubscriptionExpiresAt.Value.ToString("MMM d, yyyy")
                            </MudText>
                            <MudText Typo="Typo.caption"
                                     Color="@(days <= 0 ? Color.Error : days <= 30 ? Color.Warning : Color.Inherit)">
                                @(days <= 0 ? "Expired" : $"{days}d remaining")
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Inherit">—</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="App URL">
                        @if (!string.IsNullOrEmpty(context.AppUrl))
                        {
                            <a href="https://@context.AppUrl" target="_blank" style="color:#00BFA5;font-size:0.8rem;">
                                @context.AppUrl
                            </a>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Inherit">—</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        @if (string.IsNullOrEmpty(context.TenantSlug))
                        {
                            <MudTooltip Text="Provision database">
                                <MudIconButton Icon="@Icons.Material.Filled.Storage"
                                               Color="Color.Primary" Size="Size.Medium"
                                               OnClick="@(() => OpenProvisionWizardAsync(context))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="View details">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                           Color="Color.Primary" Size="Size.Medium"
                                           OnClick="@(() => ViewDetailsAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Send email">
                            <MudIconButton Icon="@Icons.Material.Filled.Email"
                                           Color="Color.Default" Size="Size.Medium"
                                           OnClick="@(() => OpenComposeEmailAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Extend subscription">
                            <MudIconButton Icon="@Icons.Material.Filled.EventRepeat"
                                           Color="Color.Warning" Size="Size.Medium"
                                           OnClick="@(() => ExtendSubscriptionAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Record payment">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCard"
                                           Color="Color.Success" Size="Size.Medium"
                                           OnClick="@(() => RecordPaymentAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">No active clients.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        <!-- ── Search All Users ────────────────────────────────── -->
        <MudPaper Elevation="2" Class="mb-5" Style="border-radius:12px;overflow:hidden;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3" Style="border-bottom:1px solid #e5e7eb;">
                <MudIcon Icon="@Icons.Material.Filled.Search" Color="Color.Default" />
                <MudText Typo="Typo.h6">Search All Users</MudText>
            </MudStack>
            <div class="pa-3">
                <MudTextField @bind-Value="_searchQuery"
                              Placeholder="Search by name, email or store…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              OnDebounceIntervalElapsed="SearchAsync"
                              DebounceInterval="350"
                              Variant="Variant.Outlined"
                              Dense="true"
                              Class="mb-3" />
            </div>
            @if (_searchResults is not null)
            {
                <MudTable Items="@_searchResults" Hover="true" Dense="false" Elevation="0" Breakpoint="Breakpoint.Md">
                    <HeaderContent>
                        <MudTh Style="font-weight:600;">Name</MudTh>
                        <MudTh Style="font-weight:600;">Email</MudTh>
                        <MudTh Style="font-weight:600;">Plan</MudTh>
                        <MudTh Style="font-weight:600;">Status</MudTh>
                        <MudTh Style="font-weight:600;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">
                            <MudText Typo="Typo.body2">@context.FirstName @context.LastName</MudText>
                        </MudTd>
                        <MudTd DataLabel="Email">
                            <MudText Typo="Typo.caption">@context.Email</MudText>
                        </MudTd>
                        <MudTd DataLabel="Plan">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                @context.SelectedPlan
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Color="@ActivationStatusColor(context.ActivationStatus)">
                                @context.ActivationStatus
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudTooltip Text="View details">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Color="Color.Primary" Size="Size.Medium"
                                               OnClick="@(() => ViewDetailsAsync(context))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">No users match your search.</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudPaper>
    }

</MudContainer>
}

@code {
    private bool         _authChecked  = false;
    private bool         _loading      = true;
    private string?      _loadError;

    private AdminSummary _summary          = new(0, 0, 0, 0);
    private List<User>   _pendingUsers     = new();
    private List<User>   _activeUsers      = new();
    private List<User>   _upcomingRenewals = new();
    private decimal      _revenueThisMonth = 0m;

    private string       _searchQuery   = "";
    private List<User>?  _searchResults;

    // ── Demo tenants ──────────────────────────────────────────────────
    private record DemoTenant(string Slug, string StoreName, string Plan, string Type);

    private static readonly DemoTenant[] _demoTenants =
    [
        new("mobileshop", "TechZone Mobile",  "Growth", "MobileShop"),
        new("restaurant", "The Grand Bistro", "Pro",    "Restaurant"),
        new("grocery",    "Nature's Harvest", "Growth", "GroceryNuts"),
    ];

    private HashSet<string> _seeding  = new(StringComparer.OrdinalIgnoreCase);
    private bool            _migrating;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _authChecked) return;

        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/login?returnUrl=admin/clients", forceLoad: true);
                return;
            }
            if (!auth.User.IsInRole("Admin"))
            {
                Nav.NavigateTo("/", forceLoad: false);
                return;
            }

            _authChecked = true;
            StateHasChanged();

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _loadError   = $"Auth error: {ex.Message}";
            _loading     = false;
            _authChecked = true;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading   = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            var summaryTask  = AdminService.GetSummaryAsync();
            var pendingTask  = AdminService.GetPendingUsersAsync();
            var activeTask   = AdminService.GetActiveUsersAsync();
            var revenueTask  = AdminService.GetRevenueThisMonthAsync();

            await Task.WhenAll(summaryTask, pendingTask, activeTask, revenueTask);

            _summary          = summaryTask.Result;
            _pendingUsers     = pendingTask.Result;
            _activeUsers      = activeTask.Result;
            _revenueThisMonth = revenueTask.Result;

            var now = DateTime.UtcNow;
            _upcomingRenewals = _activeUsers
                .Where(u => u.SubscriptionExpiresAt.HasValue
                         && u.SubscriptionExpiresAt.Value > now
                         && u.SubscriptionExpiresAt.Value <= now.AddDays(30))
                .ToList();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load clients: {ex.Message}";
            Snackbar.Add(_loadError, Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchResults = null;
            return;
        }

        try
        {
            _searchResults = await AdminService.SearchUsersAsync(_searchQuery);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Search failed: {ex.Message}", Severity.Error);
        }
    }

    // ── Demo tenant actions ────────────────────────────────────────────
    private async Task SeedTenantAsync(string slug)
    {
        if (_seeding.Contains(slug)) return;
        _seeding.Add(slug);
        StateHasChanged();

        try
        {
            var ok = await ProvisioningService.SeedDemoTenantAsync(slug);
            Snackbar.Add(ok
                ? $"{slug} re-seeded successfully."
                : $"Re-seed failed for {slug} — check logs.",
                ok ? Severity.Success : Severity.Error);
        }
        finally
        {
            _seeding.Remove(slug);
            StateHasChanged();
        }
    }

    private async Task RunMigrationsAsync()
    {
        if (_migrating) return;
        _migrating = true;
        StateHasChanged();

        try
        {
            var ok = await ProvisioningService.RunMigrationsAsync();
            Snackbar.Add(ok
                ? "Migrations completed successfully."
                : "Migration run failed — check logs.",
                ok ? Severity.Success : Severity.Error);
        }
        finally
        {
            _migrating = false;
            StateHasChanged();
        }
    }

    // ── Provisioning wizard ──────────────────────────────────────────
    private async Task OpenProvisionWizardAsync(User user)
    {
        var parameters = new DialogParameters<ProvisionDbWizard> { { x => x.User, user } };
        var options    = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = false };
        var dialog     = await DialogService.ShowAsync<ProvisionDbWizard>("Provision Database", parameters, options);
        var result     = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync(); // Refresh the clients grid
    }

    // ── Client actions ────────────────────────────────────────────────
    private async Task ActivateClientAsync(User user)
    {
        var parameters = new DialogParameters<ActivateClientDialog> { { x => x.User, user } };
        var options    = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog     = await DialogService.ShowAsync<ActivateClientDialog>("Activate Client", parameters, options);
        var result     = await dialog.Result;
        if (result is null || result.Canceled) return;

        var (slug, expiresAt) = ((string, DateTime?))result.Data!;
        var appUrl = $"{slug}.cloudmpos.com";

        var ok = await AdminService.ActivateUserAsync(user.Id, appUrl, expiresAt);
        if (ok)
        {
            Snackbar.Add($"{user.StoreName} activated — {appUrl}", Severity.Success);
            var updated = await AdminService.GetUserByIdAsync(user.Id);
            if (updated is not null)
                _ = EmailService.SendWelcomeEmailAsync(updated, appUrl);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"Failed to activate {user.StoreName}.", Severity.Error);
        }
    }

