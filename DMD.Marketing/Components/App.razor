    <base href="/" />

    <!-- MudBlazor -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Inter:wght@300;400;500;600&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />

    <link rel="icon" href="/Images/DMD_POS_favicon.ico" />
    <title>Cloud Mobil POS — Smart Retail Management</title>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="/js/auth.js"></script>
    <script>
        window._resizeHandlers = window._resizeHandlers || new Map();

        window.registerResizeHandler = function (dotNetHelper) {
            const handler = function () {
                if (window.innerWidth >= 960) {
                    dotNetHelper.invokeMethodAsync('CloseDrawerIfDesktop');
                }
            };
            window.addEventListener('resize', handler);
            window._resizeHandlers.set(dotNetHelper, handler);
        };

        window.unregisterResizeHandler = function (dotNetHelper) {
            const handler = window._resizeHandlers.get(dotNetHelper);
            if (handler) {
                window.removeEventListener('resize', handler);
                window._resizeHandlers.delete(dotNetHelper);
            }
        };
    </script>
</body>
</html>
