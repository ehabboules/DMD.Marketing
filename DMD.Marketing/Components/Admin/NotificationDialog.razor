@namespace DMD.Marketing.Components.Admin
@using DMD.Marketing.Services
@inject EmailService EmailService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Send Notification</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">

            <!-- ── Recipient picker ─────────────────────────────── -->
            <MudAutocomplete T="ClientInfo"
                             Label="Recipient"
                             Variant="Variant.Outlined"
                             @bind-Value="_recipient"
                             SearchFunc="SearchClients"
                             ToStringFunc="@(c => c is null ? "" : $"{c.StoreName} — {c.Email}")"
                             ResetValueOnEmptyText="true"
                             Clearable="true"
                             AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                             Adornment="Adornment.End"
                             HelperText="Search by store name or email address"
                             Disabled="_sending"
                             Dense="false">
                <ItemTemplate Context="c">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="padding:4px 0;">
                        <MudAvatar Style="width:32px;height:32px;font-size:0.8rem;background:#1A237E;color:#fff;font-weight:700;flex-shrink:0;">
                            @(string.IsNullOrWhiteSpace(c.FirstName) ? "?" : c.FirstName[0].ToString().ToUpper())
                        </MudAvatar>
                        <div style="min-width:0;">
                            <MudText Typo="Typo.body2" Class="font-weight-bold" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @c.StoreName
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @c.FirstName @c.LastName · @c.Email
                            </MudText>
                        </div>
                        <MudSpacer />
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(c.Status)"
                                 Variant="Variant.Filled" Style="flex-shrink:0;margin:0;">
                            @c.Status
                        </MudChip>
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>

            <!-- ── Selected client summary ──────────────────────── -->
            @if (_recipient is not null)
            {
                <MudPaper Elevation="0" Class="pa-3"
                          Style="background:#F0FBF8;border-radius:10px;border:1px solid #A7F3D0;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudAvatar Style="background:#1A237E;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;">
                            @(string.IsNullOrWhiteSpace(_recipient.FirstName) ? "?" : _recipient.FirstName[0].ToString().ToUpper())
                        </MudAvatar>
                        <div style="flex:1;min-width:0;">
                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                @_recipient.FirstName @_recipient.LastName
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                @_recipient.Email
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">
                                @_recipient.PlanSlug · @_recipient.BillingCycle
                                @if (!string.IsNullOrEmpty(_recipient.AppUrl))
                                {
                                    <span> · <a href="@_recipient.AppUrl" target="_blank" style="color:#00897B;">App ↗</a></span>
                                }
                            </MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@StatusColor(_recipient.Status)"
                                 Variant="Variant.Filled">
                            @_recipient.Status
                        </MudChip>
                    </MudStack>
                </MudPaper>
            }

            <MudDivider />

            <!-- ── Subject ──────────────────────────────────────── -->
            <MudTextField @bind-Value="_subject"
                          Label="Subject"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Subject"
                          Placeholder="e.g. Your store is ready!"
                          HelperText="Shown as the email subject line"
                          Disabled="_sending" />

            <!-- ── Message body ─────────────────────────────────── -->
            <MudTextField @bind-Value="_body"
                          Label="Message"
                          Variant="Variant.Outlined"
                          Lines="7"
                          Placeholder="Write your message here. The recipient's first name will be used in the greeting."
                          HelperText="Plain text — line breaks preserved"
                          Disabled="_sending" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())"
                   Variant="Variant.Text"
                   Disabled="_sending">
            Cancel
        </MudButton>
        <MudButton OnClick="SendAsync"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Send"
                   Disabled="@(_sending || _recipient is null
                                        || string.IsNullOrWhiteSpace(_subject)
                                        || string.IsNullOrWhiteSpace(_body))">
            @(_sending ? "Sending…" : "Send")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Full client list for the autocomplete picker.</summary>
    [Parameter] public List<ClientInfo> AllClients { get; set; } = new();

    /// <summary>Optional pre-selected client (e.g. opened from a row action).</summary>
    [Parameter] public ClientInfo? Client { get; set; }

    private ClientInfo? _recipient;
    private string  _subject = "";
    private string  _body    = "";
    private bool    _sending;
    private string? _error;

    protected override void OnParametersSet()
    {
        // Pre-select if a specific client was passed in
        if (_recipient is null && Client is not null)
            _recipient = Client;
    }

    // ── Autocomplete search ───────────────────────────────────────────
    private Task<IEnumerable<ClientInfo>> SearchClients(string text, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult<IEnumerable<ClientInfo>>(AllClients);

        var results = AllClients.Where(c =>
            c.StoreName.Contains(text, StringComparison.OrdinalIgnoreCase) ||
            c.Email.Contains(text, StringComparison.OrdinalIgnoreCase) ||
            c.FirstName.Contains(text, StringComparison.OrdinalIgnoreCase) ||
            c.LastName.Contains(text, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(results);
    }

    // ── Send ─────────────────────────────────────────────────────────
    private async Task SendAsync()
    {
        if (_recipient is null || string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_body))
            return;

        _sending = true;
        _error   = null;

        try
        {
            var ok = await EmailService.SendAdminNotificationAsync(
                _recipient.Email, _recipient.FirstName, _subject.Trim(), _body.Trim());

            if (ok)
            {
                Snackbar.Add($"Notification sent to {_recipient.Email}.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _error = "Failed to send — check SendGrid configuration.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }

    private static Color StatusColor(string s) => s switch
    {
        "Active"       => Color.Success,
        "Provisioning" => Color.Info,
        "Pending"      => Color.Warning,
        "Rejected"     => Color.Error,
        _              => Color.Inherit
    };
}
