@using DMD.Marketing.Services
@using DMD.Marketing.Data
@using DMD.Marketing.Models
@inject TenantMigrationService MigrationService
@inject TenantSeederService SeederService
@inject ClientActivationService ActivationService
@inject ILogger<ProvisionDbWizard> Logger

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Provision Database — @User.StoreName</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="min-height:380px;max-height:70vh;overflow-y:auto;">

        @* ── Step 1: Confirm client + slug ─────────────────────────── *@
        @if (_step == 1)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-3">Step 1 of 5 — Confirm details</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_slug" Label="Tenant Slug" Variant="Variant.Outlined"
                                  HelperText="Lowercase, alphanumeric + dashes. Becomes subdomain."
                                  Immediate="true" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_seedProfile" Label="Seed Profile" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="SeedProfile.GenericStore">Generic Store</MudSelectItem>
                        <MudSelectItem Value="SeedProfile.Restaurant">Restaurant</MudSelectItem>
                        <MudSelectItem Value="SeedProfile.MobileShop">Mobile Shop</MudSelectItem>
                        <MudSelectItem Value="SeedProfile.GroceryNuts">Grocery / Nuts</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudPaper Elevation="0" Class="pa-3 mt-3" Style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2"><strong>Store:</strong> @User.StoreName</MudText>
                    <MudText Typo="Typo.body2"><strong>Email:</strong> @User.Email</MudText>
                    <MudText Typo="Typo.body2"><strong>Plan:</strong> @User.SelectedPlan · @User.BillingCycle</MudText>
                    <MudText Typo="Typo.body2"><strong>Business type:</strong> @(User.BusinessType ?? "—")</MudText>
                </MudStack>
            </MudPaper>

            @if (!string.IsNullOrEmpty(_slugError))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_slugError</MudAlert>
            }
        }

        @* ── Step 2: Paste connection string ────────────────────────── *@
        @if (_step == 2)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-3">Step 2 of 5 — Create Postgres Database</MudText>

            <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:#E8F5E9;border:1px solid #A5D6A7;border-radius:8px;">
                <MudText Typo="Typo.subtitle2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Style="color:#2E7D32;" />
                    Railway — Create a Postgres database manually:
                </MudText>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">1. Open your Railway project dashboard</MudText>
                    <MudText Typo="Typo.body2">2. Click <strong>+ New</strong> → <strong>Database</strong> → <strong>Add PostgreSQL</strong></MudText>
                    <MudText Typo="Typo.body2">3. Wait ~60 seconds for the green ✓ (deployed)</MudText>
                    <MudText Typo="Typo.body2">4. Click the Postgres service → <strong>Connect</strong> tab</MudText>
                    <MudText Typo="Typo.body2">5. Under <strong>Available Variables</strong> copy <strong>DATABASE_URL</strong></MudText>
                    <MudText Typo="Typo.body2">6. Paste it in the field below</MudText>
                </MudStack>
            </MudPaper>

            <MudTextField @bind-Value="_connectionString"
                          Label="Postgres Connection URL"
                          Placeholder="postgresql://postgres:password@host.railway.app:1234/railway"
                          Variant="Variant.Outlined"
                          Lines="2"
                          InputType="InputType.Password"
                          HelperText="Paste the DATABASE_URL from Railway's Connect tab (External)"
                          Margin="Margin.Dense"
                          Immediate="true" />

            @if (!string.IsNullOrEmpty(_connectionStringError))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_connectionStringError</MudAlert>
            }
        }

        @* ── Steps 3–4: Execution steps ─────────────────────────────── *@
        @if (_step is >= 3 and <= 4)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-3">Step @_step of 5 — @StepTitle(_step)</MudText>
            <MudTimeline TimelinePosition="TimelinePosition.Start">
                @foreach (var s in _steps)
                {
                    <MudTimelineItem Color="@StepColor(s.Status)" Size="Size.Small">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            @if (s.Status == StepStatus.Running)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                            }
                            else if (s.Status == StepStatus.Done)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            }
                            else if (s.Status == StepStatus.Failed)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Default" Size="Size.Small" />
                            }
                            <MudText Typo="Typo.body1">@s.Title</MudText>
                        </MudStack>
                        @if (!string.IsNullOrEmpty(s.Detail))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Inherit" Class="ml-8">@s.Detail</MudText>
                        }
                        @if (!string.IsNullOrEmpty(s.Error))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1 ml-8">@s.Error</MudAlert>
                        }
                    </MudTimelineItem>
                }
            </MudTimeline>
        }

        @* ── Step 5: Summary ────────────────────────────────────────── *@
        @if (_step == 5)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-3">Step 5 of 5 — Complete</MudText>
            <MudAlert Severity="Severity.Success" Class="mb-3">
                Database provisioned and client activated successfully.
            </MudAlert>
            <MudPaper Elevation="0" Class="pa-4" Style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
                <MudStack Spacing="2">
                    <MudText><strong>App URL:</strong> @_activationResult?.AppUrl</MudText>
                    <MudText><strong>Expires:</strong> @_activationResult?.ExpiresAt.ToString("yyyy-MM-dd")</MudText>
                    <MudText><strong>Welcome email:</strong> @(_activationResult?.WelcomeEmailSent == true ? "Sent" : "Not sent")</MudText>
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.caption" Color="Color.Warning">
                        The admin user's temporary password was set by the seeder. The client should log in and change it.
                    </MudText>
                </MudStack>
            </MudPaper>
        }

        </MudContainer>
    </DialogContent>
    <DialogActions>
        @if (_step == 1)
        {
            <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
            <MudButton OnClick="GoToConnectionString" Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="@(string.IsNullOrWhiteSpace(_slug))">
                Next →
            </MudButton>
        }
        else if (_step == 2)
        {
            <MudButton OnClick="@(() => _step = 1)" Color="Color.Default">← Back</MudButton>
            <MudButton OnClick="StartProvisioning" Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="@(string.IsNullOrWhiteSpace(_connectionString) || _running)">
                Start Provisioning
            </MudButton>
        }
        else if (_step is >= 3 and <= 4)
        {
            @if (_failed)
            {
                <MudButton OnClick="RetryCurrentStep" Color="Color.Warning" Variant="Variant.Filled"
                           Disabled="_running" StartIcon="@Icons.Material.Filled.Replay">
                    Retry
                </MudButton>
                <MudButton OnClick="Cancel" Color="Color.Default">Close</MudButton>
            }
            else
            {
                <MudButton OnClick="Cancel" Color="Color.Default" Disabled="_running">Cancel</MudButton>
            }
        }
        else if (_step == 5)
        {
            <MudButton OnClick="Done" Color="Color.Primary" Variant="Variant.Filled">Done</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public User User { get; set; } = null!;

    // ── State ────────────────────────────────────────────────────────
    private string  _slug              = "";
    private string? _slugError;
    private string  _connectionString  = "";
    private string? _connectionStringError;
    private SeedProfile _seedProfile   = SeedProfile.GenericStore;

    private int  _step    = 1;
    private bool _running = false;
    private bool _failed  = false;

    private MigrationStep?    _migrationResult;
    private SeedStep?         _seedResult;
    private ActivationResult? _activationResult;

    private readonly List<WizardStep> _steps = new()
    {
        new("Register Tenant") { Status = StepStatus.Pending },
        new("Run Migrations")  { Status = StepStatus.Pending },
        new("Seed Database")   { Status = StepStatus.Pending },
        new("Activate Client") { Status = StepStatus.Pending },
    };

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_slug) && !string.IsNullOrEmpty(User.StoreName))
        {
            _slug = System.Text.RegularExpressions.Regex
                .Replace(User.StoreName.Trim().ToLowerInvariant(), @"[^a-z0-9\-]", "-")
                .Trim('-');
        }

        _seedProfile = (User.BusinessType?.ToLowerInvariant()) switch
        {
            "restaurant" => SeedProfile.Restaurant,
            "grocery"    => SeedProfile.GroceryNuts,
            _            => SeedProfile.GenericStore
        };
    }

    // ── Navigation ───────────────────────────────────────────────────
    private void Cancel() => MudDialog.Cancel();
    private void Done()   => MudDialog.Close(DialogResult.Ok(true));

    private void GoToConnectionString()
    {
        _slug = _slug.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(_slug) || _slug.Length < 2)
        {
            _slugError = "Slug must be at least 2 characters.";
            return;
        }
        _slugError = null;
        _step = 2;
    }

    private async Task StartProvisioning()
    {
        _connectionString = _connectionString.Trim();
        if (string.IsNullOrWhiteSpace(_connectionString))
        {
            _connectionStringError = "Please paste the Postgres connection string.";
            return;
        }
        _connectionStringError = null;
        _step = 3;
        await RunProvisioningAsync();
    }

    private async Task RetryCurrentStep()
    {
        _failed = false;
        // Reset failed steps so the UI shows Running again on retry
        if (_migrationResult is null || !_migrationResult.Succeeded)
        {
            _steps[0].Status = StepStatus.Pending; _steps[0].Error = null;
            _steps[1].Status = StepStatus.Pending; _steps[1].Error = null;
        }
        if (_seedResult is null || !_seedResult.Succeeded)
        {
            _steps[2].Status = StepStatus.Pending; _steps[2].Error = null;
        }
        if (_activationResult is null || !_activationResult.Succeeded)
        {
            _steps[3].Status = StepStatus.Pending; _steps[3].Error = null;
        }
        await RunProvisioningAsync();
    }

    // ── Main provisioning flow ───────────────────────────────────────
    private async Task RunProvisioningAsync()
    {
        _running = true;
        StateHasChanged();

        try
        {
            // ── Step 3: Register Tenant + Run Migrations ─────────────
            if (_migrationResult is null || !_migrationResult.Succeeded)
            {
                _step = 3;
                _steps[0].Status = StepStatus.Running;
                _steps[0].Detail = "Registering tenant in StockShopOnline…";
                _steps[0].Error  = null;
                StateHasChanged();

                try
                {
                    _migrationResult = await MigrationService.MigrateAsync(
                        _slug, _connectionString, CancellationToken.None);

                    if (_migrationResult.Succeeded)
                    {
                        _steps[0].Status = StepStatus.Done;
                        _steps[0].Detail = "Tenant registered";
                        _steps[1].Status = StepStatus.Done;
                        _steps[1].Detail = "Migrations applied";
                    }
                    else if (_migrationResult.Status == "RegistrationFailed")
                    {
                        _steps[0].Status = StepStatus.Failed;
                        _steps[0].Error  = _migrationResult.Error;
                        _failed = true;
                        return;
                    }
                    else
                    {
                        // Registration succeeded, migrations failed
                        _steps[0].Status = StepStatus.Done;
                        _steps[0].Detail = "Tenant registered";
                        _steps[1].Status = StepStatus.Failed;
                        _steps[1].Error  = _migrationResult.Error;
                        _failed = true;
                        return;
                    }
                }
                catch (Exception ex)
                {
                    _steps[0].Status = StepStatus.Failed;
                    _steps[0].Error  = ex.Message;
                    _failed = true;
                    return;
                }
                finally { StateHasChanged(); }
            }

            // ── Step 4: Seed + Activate ───────────────────────────────
            _step = 4;

            if (_seedResult is null || !_seedResult.Succeeded)
            {
                _steps[2].Status = StepStatus.Running;
                _steps[2].Detail = $"Seeding with profile '{_seedProfile}'…";
                _steps[2].Error  = null;
                StateHasChanged();

                try
                {
                    _seedResult = await SeederService.SeedAsync(
                        _slug, _connectionString, _seedProfile, CancellationToken.None);

                    if (_seedResult.Succeeded)
                    {
                        _steps[2].Status = StepStatus.Done;
                        _steps[2].Detail = $"Seeded ({_seedProfile})";
                    }
                    else
                    {
                        _steps[2].Status = StepStatus.Failed;
                        _steps[2].Error  = _seedResult.Error;
                        _failed = true;
                        return;
                    }
                }
                catch (Exception ex)
                {
                    _steps[2].Status = StepStatus.Failed;
                    _steps[2].Error  = ex.Message;
                    _failed = true;
                    return;
                }
                finally { StateHasChanged(); }
            }

            if (_activationResult is null || !_activationResult.Succeeded)
            {
                _steps[3].Status = StepStatus.Running;
                _steps[3].Detail = "Activating client…";
                _steps[3].Error  = null;
                StateHasChanged();

                try
                {
                    _activationResult = await ActivationService.ActivateAsync(
                        User.Id, _slug, CancellationToken.None);

                    if (_activationResult.Succeeded)
                    {
                        _steps[3].Status = StepStatus.Done;
                        _steps[3].Detail = $"Active — {_activationResult.AppUrl}";
                    }
                    else
                    {
                        _steps[3].Status = StepStatus.Failed;
                        _steps[3].Error  = _activationResult.Error;
                        _failed = true;
                        return;
                    }
                }
                catch (Exception ex)
                {
                    _steps[3].Status = StepStatus.Failed;
                    _steps[3].Error  = ex.Message;
                    _failed = true;
                    return;
                }
                finally { StateHasChanged(); }
            }

            // All done
            _step = 5;
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────
    private static string StepTitle(int step) => step switch
    {
        3 => "Register & Migrate",
        4 => "Seed & Activate",
        _ => ""
    };

    private static Color StepColor(StepStatus status) => status switch
    {
        StepStatus.Running => Color.Primary,
        StepStatus.Done    => Color.Success,
        StepStatus.Failed  => Color.Error,
        _                  => Color.Default
    };

    private enum StepStatus { Pending, Running, Done, Failed }

    private class WizardStep
    {
        public string     Title  { get; }
        public StepStatus Status { get; set; }
        public string?    Detail { get; set; }
        public string?    Error  { get; set; }
        public WizardStep(string title) => Title = title;
    }
}
