@namespace DMD.Marketing.Layout
@using System.Security.Claims
@inject NavigationManager Nav
@implements IDisposable

<nav class="dmd-navbar">

    <!-- Logo -->
    <a href="/" class="dmd-logo">
        <img src="images/DMD_POS_scalable.svg" alt="Cloud Mobil POS" width="32" height="32" />
        <span class="dmd-logo-text">Cloud Mobil POS</span>
    </a>

    <!-- Desktop menu -->
    <ul class="dmd-nav-links">

        <!-- Product dropdown -->
        <li class="dmd-has-dropdown" @onmouseenter="@(() => _open = "product")" @onmouseleave="@(() => _open = "")">
            <button class="dmd-nav-btn @(_open == "product" ? "dmd-nav-btn--active" : "") @(IsProductRoute ? "dmd-nav-btn--page-active" : "")">
                Product
                <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="@("dmd-chevron " + (_open == "product" ? "dmd-chevron--up" : ""))" />
            </button>
            <div class="dmd-dropdown @(_open == "product" ? "dmd-dropdown--open" : "")">
                <a href="/features" class="dmd-drop-link @(IsPath("/features") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#00BFA5;"><MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Features</strong><span>Everything Cloud Mobil POS can do</span></span>
                </a>
                <a href="/pos-system" class="dmd-drop-link @(IsPath("/pos-system") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#00BFA5;"><MudIcon Icon="@Icons.Material.Filled.PointOfSale" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Point of Sale</strong><span>Fast, modern checkout experience</span></span>
                </a>
                <a href="/inventory-management" class="dmd-drop-link @(IsPath("/inventory-management") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#00BFA5;"><MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Inventory</strong><span>Multi-warehouse stock control</span></span>
                </a>
                <a href="/reports-analytics" class="dmd-drop-link @(IsPath("/reports-analytics") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#00BFA5;"><MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Reports &amp; Analytics</strong><span>Profit, sales &amp; valuation reports</span></span>
                </a>
                <a href="/clover-app" class="dmd-drop-link @(IsPath("/clover-app") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#00BFA5;"><MudIcon Icon="@Icons.Material.Filled.Devices" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Clover App</strong><span>CloudMPOS on your Clover terminal</span></span>
                </a>
            </div>
        </li>

        <!-- Solutions dropdown -->
        <li class="dmd-has-dropdown" @onmouseenter="@(() => _open = "solutions")" @onmouseleave="@(() => _open = "")">
            <button class="dmd-nav-btn @(_open == "solutions" ? "dmd-nav-btn--active" : "") @(IsSolutionsRoute ? "dmd-nav-btn--page-active" : "")">
                Solutions
                <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="@("dmd-chevron " + (_open == "solutions" ? "dmd-chevron--up" : ""))" />
            </button>
            <div class="dmd-dropdown @(_open == "solutions" ? "dmd-dropdown--open" : "")">
                <a href="/retail" class="dmd-drop-link @(IsPath("/retail") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#1A237E;"><MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Retail Stores</strong><span>General &amp; specialty retail</span></span>
                </a>
                <a href="/dry-goods" class="dmd-drop-link @(IsPath("/dry-goods") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#1A237E;"><MudIcon Icon="@Icons.Material.Filled.SetMeal" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Nuts &amp; Dry Goods</strong><span>Bulk &amp; weight-based inventory</span></span>
                </a>
                <a href="/restaurants" class="dmd-drop-link @(IsPath("/restaurants") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#1A237E;"><MudIcon Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Restaurants</strong><span>Table management &amp; kitchen flow</span></span>
                </a>
            </div>
        </li>

        <!-- Company dropdown -->
        <li class="dmd-has-dropdown" @onmouseenter="@(() => _open = "company")" @onmouseleave="@(() => _open = "")">
            <button class="dmd-nav-btn @(_open == "company" ? "dmd-nav-btn--active" : "") @(IsCompanyRoute ? "dmd-nav-btn--page-active" : "")">
                Company
                <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="@("dmd-chevron " + (_open == "company" ? "dmd-chevron--up" : ""))" />
            </button>
            <div class="dmd-dropdown @(_open == "company" ? "dmd-dropdown--open" : "")">
                <a href="/about" class="dmd-drop-link @(IsPath("/about") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#FF6F00;"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>About Cloud Mobil POS</strong><span>Scale without limits.</span></span>
                </a>
                <a href="/blog" class="dmd-drop-link @(IsPath("/blog") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#FF6F00;"><MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Blog</strong><span>Tips, news &amp; product updates</span></span>
                </a>
                <a href="/contact" class="dmd-drop-link @(IsPath("/contact") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#FF6F00;"><MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Contact Us</strong><span>Get in touch with our team</span></span>
                </a>
                <a href="/privacy" class="dmd-drop-link @(CurrentPath.StartsWith("/privacy") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#FF6F00;"><MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Privacy Policy</strong><span>How we handle your data</span></span>
                </a>
                <a href="/terms" class="dmd-drop-link @(CurrentPath.StartsWith("/terms") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#FF6F00;"><MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Terms of Service</strong><span>Your rights and obligations</span></span>
                </a>
                <a href="/cookies" class="dmd-drop-link @(CurrentPath.StartsWith("/cookies") ? "dmd-drop-link--active" : "")" @onclick="Close">
                    <span class="dmd-drop-icon" style="color:#FF6F00;"><MudIcon Icon="@Icons.Material.Filled.Cookie" Size="Size.Small" /></span>
                    <span class="dmd-drop-text"><strong>Cookie Policy</strong><span>What we store and why</span></span>
                </a>
            </div>
        </li>

        <!-- Pricing — standalone -->
        <li>
            <a href="/pricing" class="dmd-nav-link-plain @(IsPath("/pricing") ? "dmd-nav-link-plain--active" : "")" @onclick="Close">Pricing</a>
        </li>

    </ul>

    <!-- Right CTAs — auth-aware -->
    <div class="dmd-nav-actions">
        <AuthorizeView>

            <Authorized Context="auth">
                <!-- User menu -->
                <div class="dmd-has-dropdown"
                     @onmouseenter="@(() => _open = "user")"
                     @onmouseleave="@(() => _open = "")">
                    <button class="dmd-user-btn @(_open == "user" ? "dmd-nav-btn--active" : "")">
                        <span class="dmd-user-avatar">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="color:#fff;" />
                        </span>
                        <span class="dmd-user-name">
                            @(auth.User.FindFirst(ClaimTypes.GivenName)?.Value ?? auth.User.FindFirst(ClaimTypes.Name)?.Value ?? "Account")
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="@("dmd-chevron " + (_open == "user" ? "dmd-chevron--up" : ""))" />
                    </button>
                    <div class="dmd-dropdown dmd-dropdown--right @(_open == "user" ? "dmd-dropdown--open" : "")">
                        <a href="/profile" class="dmd-drop-link" @onclick="Close">
                            <span class="dmd-drop-icon" style="color:#00BFA5;"><MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" /></span>
                            <span class="dmd-drop-text"><strong>My Profile</strong><span>Plan &amp; account settings</span></span>
                        </a>
                        <AuthorizeView Roles="Admin" Context="adminCtx">
                            <Authorized>
                                <div style="height:1px;background:#F3F4F6;margin:4px 8px;"></div>
                                <a href="/admin/clients" class="dmd-drop-link" @onclick="Close">
                                    <span class="dmd-drop-icon" style="color:#1A237E;"><MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" /></span>
                                    <span class="dmd-drop-text"><strong>Client Management</strong><span>Provisioning, billing &amp; renewals</span></span>
                                </a>
                                <a href="/admin/users" class="dmd-drop-link" @onclick="Close">
                                    <span class="dmd-drop-icon" style="color:#1A237E;"><MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" /></span>
                                    <span class="dmd-drop-text"><strong>User Roles</strong><span>Manage user permissions</span></span>
                                </a>
                            </Authorized>
                        </AuthorizeView>
                        <a href="/changepassword" class="dmd-drop-link" @onclick='() => Nav.NavigateTo("/changepassword", forceLoad: true)' @onclick:preventDefault>
                            <span class="dmd-drop-icon" style="color:#607D8B;"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /></span>
                            <span class="dmd-drop-text"><strong>Change Password</strong><span>Update your credentials</span></span>
                        </a>
                        <div style="height:1px;background:#F3F4F6;margin:4px 8px;"></div>
                        <a href="/logout" class="dmd-drop-link" style="color:#E53935;" @onclick='() => Nav.NavigateTo("/logout", forceLoad: true)' @onclick:preventDefault>
                            <span class="dmd-drop-icon" style="color:#E53935;"><MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" /></span>
                            <span class="dmd-drop-text"><strong>Sign Out</strong></span>
                        </a>
                    </div>
                </div>
            </Authorized>

            <NotAuthorized>
                <a href="/login" class="dmd-btn-login" @onclick='() => Nav.NavigateTo("/login", forceLoad: true)' @onclick:preventDefault>Sign In</a>
                <a href="/demo"     class="dmd-btn-demo">Book a Demo</a>
            </NotAuthorized>

        </AuthorizeView>
    </div>

</nav>

<style>
    /* ── Navbar shell ─────────────────────────────────────────────── */
    .dmd-navbar {
        position: sticky;
        top: 0;
        z-index: 1100;
        display: flex;
        align-items: center;
        padding: 0 32px;
        height: 68px;
        background: #ffffff;
        border-bottom: 1px solid rgba(0,0,0,0.07);
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    /* ── Logo ────────────────────────────────────────────────────── */
    .dmd-logo { display:flex;align-items:center;gap:10px;text-decoration:none;margin-right:36px;flex-shrink:0; }
    .dmd-logo-text { font-family:'Poppins',sans-serif;font-size:1.1rem;color:#1A237E;letter-spacing:-0.01em; }
    .dmd-logo-text strong { color:#00BFA5; }

    /* ── Nav link list ───────────────────────────────────────────── */
    .dmd-nav-links { display:flex;align-items:center;list-style:none;margin:0;padding:0;gap:2px;flex:1; }
    .dmd-has-dropdown { position:relative; }

    /* ── Nav button ──────────────────────────────────────────────── */
    .dmd-nav-btn {
        display:flex;align-items:center;gap:4px;padding:8px 14px;border:none;background:transparent;
        cursor:pointer;font-family:'DM Sans',sans-serif;font-size:0.9rem;font-weight:500;color:#37474F;
        border-radius:8px;transition:background 0.15s,color 0.15s;white-space:nowrap;
    }
    .dmd-nav-btn:hover, .dmd-nav-btn--active { background:rgba(0,191,165,0.08);color:#00BFA5; }

    /* ── Page-active state (current route) ──────────────────────── */
    .dmd-nav-btn--page-active {
        color: #00BFA5 !important;
        position: relative;
    }
    .dmd-nav-btn--page-active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 10px;
        right: 10px;
        height: 2px;
        background: #00BFA5;
        border-radius: 2px;
    }
    .dmd-nav-link-plain--active {
        color: #00BFA5 !important;
        font-weight: 600;
        position: relative;
    }
    .dmd-nav-link-plain--active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 10px;
        right: 10px;
        height: 2px;
        background: #00BFA5;
        border-radius: 2px;
    }
    .dmd-drop-link--active {
        background: rgba(0,191,165,0.08) !important;
        border-left: 3px solid #00BFA5;
        padding-left: 9px;
    }
    .dmd-drop-link--active .dmd-drop-text strong { color: #00897B; }

    .dmd-chevron { transition:transform 0.2s ease;flex-shrink:0; }
    .dmd-chevron--up { transform:rotate(180deg); }

    .dmd-nav-link-plain {
        display:block;padding:8px 14px;font-family:'DM Sans',sans-serif;font-size:0.9rem;font-weight:500;
        color:#37474F;text-decoration:none;border-radius:8px;transition:background 0.15s,color 0.15s;white-space:nowrap;
    }
    .dmd-nav-link-plain:hover { background:rgba(0,191,165,0.08);color:#00BFA5; }

    /* ── Dropdown ────────────────────────────────────────────────── */
    .dmd-dropdown {
        position:absolute;top:calc(100% + 8px);left:0;min-width:280px;
        background:#ffffff;border:1px solid rgba(0,0,0,0.08);border-radius:14px;
        box-shadow:0 8px 32px rgba(0,0,0,0.12);padding:8px;
        opacity:0;visibility:hidden;transform:translateY(-6px);
        transition:opacity 0.18s ease,transform 0.18s ease,visibility 0.18s;z-index:1200;
    }
    .dmd-dropdown--right { left:auto;right:0; }
    .dmd-dropdown--open  { opacity:1;visibility:visible;transform:translateY(0); }

    .dmd-drop-link {
        display:flex;align-items:flex-start;gap:12px;padding:10px 12px;
        border-radius:10px;text-decoration:none;transition:background 0.15s;
    }
    .dmd-drop-link:hover { background:rgba(0,191,165,0.07); }
    .dmd-drop-icon  { flex-shrink:0;margin-top:2px;display:flex; }
    .dmd-drop-text  { display:flex;flex-direction:column;gap:2px; }
    .dmd-drop-text strong { font-family:'DM Sans',sans-serif;font-size:0.875rem;font-weight:600;color:#1A237E;line-height:1.3; }
    .dmd-drop-text span   { font-family:'DM Sans',sans-serif;font-size:0.75rem;color:#90A4AE;line-height:1.4; }

    /* ── User menu button ────────────────────────────────────────── */
    .dmd-user-btn {
        display:flex;align-items:center;gap:8px;padding:5px 12px 5px 5px;
        border:1.5px solid #E5E7EB;background:#fff;cursor:pointer;
        font-family:'DM Sans',sans-serif;font-size:0.875rem;font-weight:500;color:#1A237E;
        border-radius:24px;transition:border-color 0.15s,background 0.15s;white-space:nowrap;
    }
    .dmd-user-btn:hover, .dmd-user-btn.dmd-nav-btn--active { border-color:#00BFA5;background:rgba(0,191,165,0.05); }

    .dmd-user-avatar {
        width:28px;height:28px;border-radius:50%;
        background:linear-gradient(135deg,#00BFA5,#1A237E);
        color:#fff;font-family:'Poppins',sans-serif;font-size:0.8rem;font-weight:700;
        display:flex;align-items:center;justify-content:center;flex-shrink:0;
    }
    .dmd-user-name { max-width:120px;overflow:hidden;text-overflow:ellipsis; }

    /* ── CTA buttons ─────────────────────────────────────────────── */
    .dmd-nav-actions { display:flex;align-items:center;gap:10px;margin-left:auto;flex-shrink:0; }

    .dmd-btn-login {
        padding:8px 16px;border:1.5px solid rgba(26,35,126,0.25);border-radius:8px;
        font-family:'DM Sans',sans-serif;font-size:0.875rem;font-weight:600;color:#1A237E;
        text-decoration:none;transition:border-color 0.15s,background 0.15s;white-space:nowrap;
    }
    .dmd-btn-login:hover { border-color:#1A237E;background:rgba(26,35,126,0.05); }

    .dmd-btn-demo {
        padding:8px 20px;background:#00BFA5;border-radius:8px;
        font-family:'DM Sans',sans-serif;font-size:0.875rem;font-weight:700;color:#ffffff;
        text-decoration:none;transition:background 0.15s,box-shadow 0.15s;white-space:nowrap;
    }
    .dmd-btn-demo:hover { background:#00897B;box-shadow:0 4px 16px rgba(0,191,165,0.35); }
</style>

@code {
    private string _open = "";
    private void Close() => _open = "";

    private string CurrentPath =>
        new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();

    private bool IsPath(string path) => CurrentPath == path;

    private bool IsProductRoute => new[] { "/features", "/pos-system", "/inventory-management", "/reports-analytics", "/clover-app" }
        .Contains(CurrentPath);

    private bool IsSolutionsRoute => new[] { "/retail", "/dry-goods", "/restaurants" }
        .Contains(CurrentPath);

    private bool IsCompanyRoute => new[] { "/about", "/blog", "/contact" }
        .Contains(CurrentPath)
        || CurrentPath.StartsWith("/privacy")
        || CurrentPath.StartsWith("/terms")
        || CurrentPath.StartsWith("/cookies");

    protected override void OnInitialized()
        => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender,
        Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Nav.LocationChanged -= OnLocationChanged;
}
