@inherits LayoutComponentBase
@using DMD.Marketing.Layout
@using DMD.Marketing.Components

<MudRTLProvider RightToLeft="false">
    <MudThemeProvider Theme="@_theme" />
    <MudDialogProvider @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <MudSnackbarProvider @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <MudPopoverProvider @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <MudLayout>

        <MobileNav @rendermode="new InteractiveServerRenderMode()" />

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT
        ════════════════════════════════════════════════════════════════ -->
        <MudMainContent Class="dmd-main-content" Style="display:flex;flex-direction:column;min-height:100vh;">

            <!-- Desktop NavBar — hidden on mobile via CSS -->
            <div class="dmd-desktop-navbar">
                <NavBar @rendermode="new InteractiveServerRenderMode()" />
            </div>

            <main style="flex:1;">
                @Body
            </main>

            <Footer />

        </MudMainContent>

    </MudLayout>
</MudRTLProvider>

<!-- ─── COOKIE CONSENT BANNER ─── -->
<CookieConsentBanner />

<!-- ─── SCROLL TO TOP ─── -->
<MudScrollToTop>
    <MudFab Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.KeyboardArrowUp"
            Size="Size.Medium"
            Style="box-shadow:0 4px 24px rgba(25,118,210,0.45);" />
</MudScrollToTop>

<style>
    /* ── Responsive: mobile AppBar visible below 960px only ─────── */
    .dmd-mobile-appbar { display: flex !important; }

    /* ── Responsive: desktop NavBar hidden on mobile ────────────── */
    .dmd-desktop-navbar { display: none; }

    @@media (min-width: 960px) {
        .dmd-mobile-appbar  { display: none !important; }
        .dmd-desktop-navbar { display: block; }
        .dmd-main-content   { padding-top: 0 !important; }
    }
</style>

@code {
    // ── Brand theme: corporate blue primary / navy secondary / purple tertiary ──
    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary          = "#1976D2",
            PrimaryDarken    = "#1565C0",
            PrimaryLighten   = "#E3F2FD",
            Secondary        = "#1A237E",
            SecondaryDarken  = "#0D1457",
            SecondaryLighten = "#E8EAF6",
            Tertiary         = "#9C27B0",
            TertiaryDarken   = "#7B1FA2",
            TertiaryLighten  = "#F3E5F5",
            Success          = "#4CAF50",
            Info             = "#2196F3",
            Warning          = "#FF9800",
            Error            = "#F44336",
            Background       = "#FFFFFF",
            Surface          = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText       = "#1A237E",
            DrawerBackground = "#FFFFFF",
            DrawerText       = "rgba(26,35,126,0.87)",
            DrawerIcon       = "rgba(26,35,126,0.55)",
            TextPrimary      = "#1A237E",
            TextSecondary    = "#607D8B",
            TextDisabled     = "rgba(0,0,0,0.38)",
            Divider          = "rgba(0,0,0,0.08)",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" },
            },
        },
        LayoutProperties = new LayoutProperties
        {
            AppbarHeight    = "68px",
            DrawerWidthLeft = "280px",
        }
    };

}
